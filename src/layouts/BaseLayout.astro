---
import { SITE, BUSINESS, LEADERS, GA_MEASUREMENT_ID } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScanPopup from '../components/ScanPopup.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  /** Canonical path, e.g. "/about". Defaults to the current URL path. */
  path?: string;
  image?: string;
  /** "website" (default) or "article" for blog posts. */
  ogType?: 'website' | 'article';
  /** Extra JSON-LD objects (e.g. Article, FAQPage) injected into <head>. */
  schemas?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  path,
  image = SITE.defaultOgImage,
  ogType = 'website',
  schemas = [],
  noindex = false,
} = Astro.props;

const canonicalPath = path ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const fullTitle = title === SITE.name ? SITE.title : `${title} | ${SITE.name}`;

// Site-wide schema graph: Organization + LocalBusiness + WebSite.
// These are the entity-clarity signals that answer engines (AEO) rely on.
const baseSchemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.legalName,
    alternateName: SITE.name,
    url: SITE.url,
    logo: {
      '@type': 'ImageObject',
      url: new URL(SITE.logo, SITE.url).href,
    },
    description: SITE.description,
    slogan: SITE.tagline,
    founder: { '@id': `${SITE.url}/#person-gavin-dreyfus` },
    email: BUSINESS.email,
    telephone: BUSINESS.phone,
    areaServed: BUSINESS.areasServed,
    knowsAbout: [
      'Artificial intelligence deployment',
      'AI workflow automation',
      'Shadow AI risk and governance',
      'AI strategy and roadmap',
      'Managed IT services',
      'Cybersecurity for small business',
      'Technology modernization for small and mid-sized businesses',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${SITE.url}/#localbusiness`,
    name: SITE.legalName,
    image: ogImage,
    url: SITE.url,
    telephone: BUSINESS.phone,
    email: BUSINESS.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: BUSINESS.city,
      addressRegion: BUSINESS.region,
      addressCountry: 'US',
    },
    areaServed: BUSINESS.areasServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
    priceRange: '$$',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  // Leadership as first-class entities — activates the credentials already in
  // the HTML as machine-readable E-E-A-T (AEO) and links them to the org.
  ...LEADERS.map((leader) => ({
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE.url}/#person-${leader.name.toLowerCase().replace(/\s+/g, '-')}`,
    name: leader.name,
    jobTitle: leader.jobTitle,
    worksFor: { '@id': `${SITE.url}/#organization` },
    ...(leader.sameAs.length ? { sameAs: leader.sameAs } : {}),
  })),
];

const allSchemas = [...baseSchemas, ...schemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07090f" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&display=swap"
      rel="stylesheet"
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Blog`} href="/rss.xml" />

    <!-- Structured data (JSON-LD) -->
    {
      allSchemas.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }

    {/* Google Analytics 4 — only loads when GA_MEASUREMENT_ID is set in consts.ts.
        Fires `cta_click` on primary calls-to-action; `lead_submit` fires from the
        contact form. No tracking runs while the ID is empty. */}
    {
      GA_MEASUREMENT_ID && (
        <Fragment>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`} />
          <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
            {`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',id);`}
          </script>
          <script is:inline>
            {`document.addEventListener('click',function(e){if(!window.gtag)return;var el=e.target.closest('[data-cta],.btn-primary,.nav-cta,.scan-fab,.scan-popup-cta,.mobile-cta');if(!el)return;gtag('event','cta_click',{label:el.getAttribute('data-cta')||(el.textContent||'').trim().slice(0,40),href:el.getAttribute('href')||''});},true);`}
          </script>
        </Fragment>
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="site-bg" aria-hidden="true">
      <div class="bg-base"></div>
      <div class="bg-grid"></div>
      <img class="bg-logo" src="/images/bg-logo.png" alt="" />
    </div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ScanPopup />
  </body>
</html>
