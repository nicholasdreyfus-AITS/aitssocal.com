---
import { SITE, BUSINESS } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScanPopup from '../components/ScanPopup.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  /** Canonical path, e.g. "/about". Defaults to the current URL path. */
  path?: string;
  image?: string;
  /** "website" (default) or "article" for blog posts. */
  ogType?: 'website' | 'article';
  /** Extra JSON-LD objects (e.g. Article, FAQPage) injected into <head>. */
  schemas?: Record<string, unknown>[];
  noindex?: boolean;
  /** Landing mode: minimal chrome (logo-only header, slim footer, no popup)
      for dedicated conversion pages that shouldn't leak clicks to site nav. */
  landing?: boolean;
}

const {
  title,
  description = SITE.description,
  path,
  image = SITE.defaultOgImage,
  ogType = 'website',
  schemas = [],
  noindex = false,
  landing = false,
} = Astro.props;

const canonicalPath = path ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const fullTitle = title === SITE.name ? SITE.title : `${title} | ${SITE.name}`;

// Site-wide schema graph: Organization + LocalBusiness + WebSite.
// These are the entity-clarity signals that answer engines (AEO) rely on.
const baseSchemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    legalName: SITE.legalName,
    alternateName: SITE.fullName,
    url: SITE.url,
    description: SITE.description,
    slogan: SITE.tagline,
    founder: { '@type': 'Person', name: BUSINESS.founder },
    email: BUSINESS.email,
    telephone: BUSINESS.phone,
    areaServed: BUSINESS.areasServed,
    knowsAbout: [
      'Artificial intelligence deployment',
      'AI workflow automation',
      'Shadow AI risk and governance',
      'AI strategy and roadmap',
      'Managed IT services',
      'Cybersecurity for small business',
      'Technology modernization for small and mid-sized businesses',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${SITE.url}/#localbusiness`,
    name: SITE.name,
    legalName: SITE.legalName,
    image: ogImage,
    url: SITE.url,
    telephone: BUSINESS.phone,
    email: BUSINESS.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: BUSINESS.city,
      addressRegion: BUSINESS.region,
      addressCountry: 'US',
    },
    areaServed: BUSINESS.areasServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
    priceRange: '$$',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    publisher: { '@id': `${SITE.url}/#organization` },
  },
];

const allSchemas = [...baseSchemas, ...schemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XD7CWJNMG8"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-XD7CWJNMG8');
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07090f" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&display=swap"
      rel="stylesheet"
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Blog`} href="/rss.xml" />

    <!-- Structured data (JSON-LD) -->
    {
      allSchemas.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
  </head>
  <body>
    {landing && <a href="#main" class="skip-link">Skip to content</a>}
    <div class="site-bg" aria-hidden="true">
      <div class="bg-base"></div>
      <div class="bg-grid"></div>
      <img class="bg-logo" src="/images/bg-logo.png" alt="" loading="lazy" fetchpriority="low" />
    </div>
    {
      landing ? (
        <header class="lp-min-header">
          <div class="container">
            <a href="/" class="lp-min-logo" aria-label="AITS home">
              <img src="/images/logo.png" alt="AITS" width="40" height="40" />
              <span>AITS</span>
            </a>
          </div>
        </header>
      ) : (
        <Header />
      )
    }
    <main id="main">
      <slot />
    </main>
    {
      landing ? (
        <footer class="lp-min-footer">
          <div class="container">
            <span>© AITS · Advanced Intelligent Technology Solutions</span>
            <a href={`tel:${BUSINESS.phone}`}>{BUSINESS.phoneDisplay}</a>
          </div>
        </footer>
      ) : (
        <Footer />
      )
    }
    {!landing && <ScanPopup />}
    {/*
      GHL chat widget — also the declared SMS opt-in mechanism for the 10DLC
      campaign. `defer` keeps it off the critical rendering path.

      ⚠️ COMPLIANCE: the A2P registration attests that NO form collecting
      phone numbers or SMS opt-in consent exists on any page where this
      widget is embedded. That holds today because it only renders on Astro
      pages, and the only phone/SMS-consent form on the site is
      public/scan.html — a standalone file that does not use this layout.
      Before adding a phone field to any .astro page, or embedding the GHL
      booking calendar (its form collects a phone number), either exclude
      the widget from that page or the attestation is broken.
    */}
    {!landing && (
      <>
        <button
          id="alexis-chat-launcher"
          class="alexis-chat-launcher"
          type="button"
          aria-label="Chat with Alexis, the AITS AI assistant"
          hidden
        >
          <img
            src="/images/alexis-avatar.jpg"
            alt=""
            width="300"
            height="300"
            loading="lazy"
          />
          <span class="alexis-chat-launcher__status" aria-hidden="true"></span>
        </button>
        <script
          src="https://widgets.leadconnectorhq.com/loader.js"
          data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js"
          data-widget-id="6a65209ab92307bb1e76cb3e"
          defer
        ></script>
        <script is:inline>
          (() => {
            const launcher = document.getElementById('alexis-chat-launcher');
            if (!(launcher instanceof HTMLButtonElement)) return;

            const getWidgetButton = () =>
              document
                .querySelector('chat-widget')
                ?.shadowRoot
                ?.querySelector('button[aria-label*="chat widget"]');

            const syncLauncher = () => {
              const widgetButton = getWidgetButton();
              if (!(widgetButton instanceof HTMLButtonElement)) return;

              const chatIsOpen = widgetButton
                .getAttribute('aria-label')
                ?.toLowerCase()
                .includes('close');
              launcher.hidden = Boolean(chatIsOpen);
            };

            launcher.addEventListener('click', () => {
              const widgetButton = getWidgetButton();
              if (!(widgetButton instanceof HTMLButtonElement)) return;
              widgetButton.click();
              launcher.hidden = true;
            });

            const observer = new MutationObserver(syncLauncher);
            let attempts = 0;
            const maxAttempts = 80;
            const connect = () => {
              const widgetHost = document.querySelector('chat-widget');
              const widgetButton = getWidgetButton();
              if (!widgetHost || !(widgetButton instanceof HTMLButtonElement)) {
                attempts += 1;
                if (attempts >= maxAttempts) return;
                window.setTimeout(connect, 150);
                return;
              }

              launcher.hidden = false;
              observer.observe(widgetButton, {
                attributes: true,
                attributeFilter: ['aria-label'],
              });
              syncLauncher();
            };

            connect();
          })();
        </script>
      </>
    )}
  </body>
</html>

<style>
  /* Skip link — first tab stop; visible only on focus (WCAG 2.4.1). */
  .skip-link {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 1000;
    background: #2d5cd8;
    color: #fff;
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    transition: top 0.2s ease;
  }
  .skip-link:focus {
    top: 12px;
  }

  .alexis-chat-launcher {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 2147483647;
    width: 64px;
    height: 64px;
    padding: 3px;
    border: 2px solid rgba(255, 255, 255, 0.95);
    border-radius: 50%;
    background: #132a52;
    box-shadow: 0 10px 30px rgba(10, 24, 48, 0.28);
    cursor: pointer;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .alexis-chat-launcher[hidden] {
    display: none;
  }

  .alexis-chat-launcher:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 14px 34px rgba(10, 24, 48, 0.34);
  }

  .alexis-chat-launcher:focus-visible {
    outline: 3px solid #7cb8ff;
    outline-offset: 4px;
  }

  .alexis-chat-launcher img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .alexis-chat-launcher__status {
    position: absolute;
    right: 1px;
    bottom: 3px;
    width: 15px;
    height: 15px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #12b76a;
  }

  @media (max-width: 640px) {
    .alexis-chat-launcher {
      left: 14px;
      bottom: 14px;
      width: 58px;
      height: 58px;
    }
  }

  /* Minimal landing chrome — logo-only header, slim footer. Keyboard focus
     is explicit here because the shared global stylesheet has no focus ring. */
  .lp-min-header {
    position: relative;
    z-index: 10;
    border-bottom: 0.5px solid var(--border2);
    background: rgba(7, 9, 15, 0.72);
    backdrop-filter: blur(24px);
  }
  .lp-min-header .container {
    display: flex;
    align-items: center;
    height: 66px;
  }
  .lp-min-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--fran);
    font-weight: 600;
    font-size: 18px;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .lp-min-logo img {
    height: 38px;
    width: auto;
  }
  .lp-min-footer {
    position: relative;
    z-index: 10;
    border-top: 0.5px solid var(--border2);
    background: rgba(7, 9, 15, 0.72);
    padding-block: 20px;
    font-size: 13px;
    color: var(--muted);
  }
  .lp-min-footer .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .lp-min-footer a {
    color: var(--text2);
    font-weight: 600;
  }
  .lp-min-footer a:hover {
    color: var(--text);
  }
  .lp-min-header a:focus-visible,
  .lp-min-footer a:focus-visible,
  .skip-link:focus-visible {
    outline: 2px solid var(--accent2);
    outline-offset: 3px;
    border-radius: 6px;
  }
</style>
