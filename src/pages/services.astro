---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

// Every service is stated as the CLIENT outcome first, mechanism second.
const services = [
  {
    h: 'Your whole front office, handled',
    p: 'Calls answered 24/7, missed calls texted back, leads followed up until they book, appointments scheduled with reminders, invoices out same-day, reviews collected automatically, and dashboards that show which marketing pays. One managed ecosystem for one flat monthly fee — everything a mid-sized organization runs on, often at a tenth of the cost of assembling and staffing it yourself.',
  },
  {
    h: 'Websites built to be found — and to convert',
    p: 'Anyone can build a website that looks great. We build sites that look great, function flawlessly, and are engineered to be discovered: proper search engine optimization plus AI-search optimization, so customers find you on Google and through the AI assistants people now ask for recommendations. Then every visitor who hits your site or social gets cultivated — chat, follow-up, booking — so traffic becomes customers instead of bouncing.',
  },
  {
    h: 'AI assessment & roadmap',
    p: 'We map where AI should be working in your business, score your exposure to shadow AI and compliance gaps, and hand you a prioritized plan you can act on immediately — with ROI attached to every recommendation.',
  },
  {
    h: 'Task automation',
    p: 'We automate the work your team hates most first — the repetitive, manual tasks that drain hours every week — so your people get back to the work that drives revenue. We prove the value before expanding.',
  },
  {
    h: 'Technology modernization',
    p: 'AI-first, with the infrastructure underneath it. We make sure the foundation your business runs on is reliable, secure, and ready to scale — because an automation is only as dependable as what it sits on.',
  },
  {
    h: 'Team enablement & adoption',
    p: 'We train your people to work with AI confidently. Adoption is part of the engagement — not an afterthought you are left to manage alone.',
  },
  {
    h: 'AI governance & risk',
    p: 'AI usage policy, shadow-AI controls, and compliance alignment (HIPAA, CJIS, CMMC and more) so your team can move fast without creating exposure.',
  },
  {
    h: 'Proactive maintenance & managed support',
    p: 'This is where 25+ years of deploying and managing technology shows. Most AI works on day one and breaks by week three, when an update quietly snaps a connection or a platform changes its rules overnight — and most vendors charge you for every fix. We run proactive maintenance instead: your website, forms, booking, CRM, and every automation tested on a schedule, because we would rather find the problem before you do. Fixes are included in the flat fee and fixed right the first time — our incentive is to reduce the number of times you ever have to call us. Month-to-month: you stay because the results justify it.',
  },
];

// ItemList of services strengthens topical clarity for search + answer engines.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AITS Services',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@type': 'Service', name: s.h, description: s.p, provider: { '@id': `${SITE.url}/#organization` } },
  })),
};
---

<BaseLayout
  title="Services"
  description="Calls answered 24/7, leads followed up, invoices out faster — one managed system for one flat monthly fee, built on 25+ years of deploying and managing technology that has to keep working."
  path="/services"
  schemas={[serviceSchema]}
>
  <section class="section">
    <div class="container">
      <p class="section-label">What we do</p>
      <h1>We sell what changes in your business. Not a feature list.</h1>
      <p class="lede prose">
        Most vendors lead with tools; we lead with your problem and work backwards. And unlike most
        AI companies, we have spent 25+ years onboarding, integrating, deploying, and managing
        technology that has to keep working — so everything below is tested regularly, monitored,
        and covered by one flat monthly fee. Fixes included, because we profit when nothing breaks.
      </p>
      <div class="grid">
        {
          services.map((s) => (
            <div class="card">
              <h2>{s.h}</h2>
              <p>{s.p}</p>
            </div>
          ))
        }
      </div>
      <div class="cta">
        <a href="/contact" class="btn-primary">Get your free AI assessment</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    color: var(--muted);
    font-size: 1.2rem;
    margin: 16px 0 40px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .grid h2 {
    font-size: 1.2rem;
    margin-bottom: 10px;
  }
  .grid p {
    color: var(--muted);
  }
  .cta {
    margin-top: 40px;
  }
</style>
