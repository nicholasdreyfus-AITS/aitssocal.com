---
import BaseLayout from '../layouts/BaseLayout.astro';
import BorderBeam from '../components/BorderBeam.astro';
import { SITE } from '../consts';

// Every service: client outcome first. Short lede stays visible; the
// bullets reveal on hover (always visible on touch) — all indexed for SEO.
const services = [
  {
    id: 'platform',
    icon: '🧩',
    feat: true,
    h: 'Your whole front office, handled',
    lede: 'One managed ecosystem for one flat monthly fee — everything a mid-sized organization runs on, often at a tenth of the cost of assembling and staffing it yourself.',
    bullets: [
      'Calls answered 24/7 — missed calls texted back instantly',
      'Leads followed up automatically until they book',
      'Appointments, reminders, same-day invoices, payments',
      'Reviews collected automatically; dashboards show what pays',
    ],
  },
  {
    id: 'websites',
    icon: '🌐',
    h: 'Websites built to be found — and to convert',
    lede: 'Anyone can build a website that looks great. We build sites that look great, function flawlessly, and are engineered to be discovered.',
    bullets: [
      'Proper search engine optimization — built in, not bolted on',
      'AI-search optimization (AEO) so assistants recommend you',
      'Every visitor cultivated: chat → follow-up → booked',
      'Forms, booking, and integrations proactively tested',
    ],
  },
  {
    id: 'assessment',
    icon: '🗺️',
    h: 'AI assessment & roadmap',
    lede: 'We map where AI should be working in your business and hand you a prioritized plan you can act on immediately.',
    bullets: [
      'Free 30-minute assessment to start',
      'Shadow-AI and compliance exposure scored',
      'Every recommendation ranked by ROI',
    ],
  },
  {
    id: 'automation',
    icon: '⚙️',
    h: 'Task automation',
    lede: 'We automate the work your team hates most first — and prove the value before expanding.',
    bullets: [
      'The repetitive, manual tasks off your team’s plate',
      'A visible win inside the first 30 days',
      'Your people back on the work that drives revenue',
    ],
  },
  {
    id: 'modernization',
    icon: '🖥️',
    teal: true,
    h: 'Technology modernization',
    lede: 'AI-first, with the infrastructure underneath it — because an automation is only as dependable as what it sits on.',
    bullets: [
      'Computers, servers, networks, and security',
      'Reliable, secure, and ready to scale',
      'On-site support across Southern California',
    ],
  },
  {
    id: 'enablement',
    icon: '🎓',
    h: 'Team enablement & adoption',
    lede: 'Your people learn to work with AI confidently. Adoption is part of the engagement — not an afterthought.',
    bullets: [
      'Training built around your team’s real workflows',
      'Power users identified and equipped to lead',
      'Adoption measured, not assumed',
    ],
  },
  {
    id: 'governance',
    icon: '🛡️',
    h: 'AI governance & risk',
    lede: 'Your team moves fast without creating exposure.',
    bullets: [
      'An AI usage policy your team actually follows',
      'Shadow-AI controls that catch unsanctioned tools',
      'HIPAA, CJIS, CMMC and more — compliance aligned',
    ],
  },
  {
    id: 'support',
    icon: '🔧',
    teal: true,
    h: 'Proactive maintenance & managed support',
    lede: '25+ years of deploying and managing technology, working for you every month. Most AI breaks by week three — ours is tested before you ever notice.',
    bullets: [
      'Website, forms, booking, and CRM tested on a schedule',
      'We find breaks before you do — even platform rule changes',
      'Fixes included in the flat fee, done right the first time',
      'Month-to-month: you stay because the results justify it',
    ],
  },
];

// ItemList schema carries the FULL text (lede + bullets) for search + AEO.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AITS Services',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.h,
      description: `${s.lede} ${s.bullets.join('. ')}.`,
      provider: { '@id': `${SITE.url}/#organization` },
    },
  })),
};
---

<BaseLayout
  title="Services"
  description="Calls answered 24/7, websites engineered for SEO and AI search, leads cultivated into customers — one managed ecosystem from $297/month, proactively tested and fixed."
  path="/services"
  schemas={[serviceSchema]}
>
  <section class="section">
    <div class="container">
      <span class="section-label">What we do</span>
      <h1 class="section-heading">We sell what changes in your business.<br /><em>Not a feature list.</em></h1>
      <p class="section-sub">
        Most vendors lead with tools; we lead with your problem and work backwards. Everything
        below is built, tested regularly, monitored, and covered by one flat monthly fee — fixes
        included, because we profit when nothing breaks. Hover any card for the details.
      </p>

      <div class="grid-auto">
        {
          services.map((s) => (
            <BorderBeam dual={true} id={s.id} class={`card svc-card${s.feat ? ' feat' : ''}`}>
              {s.feat && <span slot="badge" class="feat-badge">Core</span>}
              <div class:list={['sicon', { teal: s.teal }]}>{s.icon}</div>
              <h2 class="svc-title">{s.h}</h2>
              <p class="svc-lede">{s.lede}</p>
              <ul class="reveal-list">
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </BorderBeam>
          ))
        }
      </div>

      <div class="price-band">
        <div class="price-num">$297<span>/mo</span></div>
        <div class="price-copy">
          <strong>Most plans start at $297 a month</strong> — and that gets you most of what is on
          our front page: the ecosystem, the proactive testing, and the fixes. Add-ons like an AI
          receptionist are available on top. Month-to-month, no lock-in. We partner with you for
          the long run, because we only grow when you grow.
        </div>
        <a href="/contact" class="btn-primary">Get your free AI assessment</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .grid-auto {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  @media (max-width: 1080px) {
    .grid-auto {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .grid-auto {
      grid-template-columns: 1fr;
    }
  }
  .svc-card {
    scroll-margin-top: 96px;
    position: relative;
    overflow: hidden;
  }
  .svc-card.feat {
    border-color: rgba(59, 110, 240, 0.4);
  }
  .feat-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    padding: 4px 11px;
    border-radius: 100px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .sicon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--aglow);
    border: 0.5px solid rgba(59, 110, 240, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    font-size: 20px;
  }
  .sicon.teal {
    background: var(--tdim);
    border-color: rgba(0, 201, 167, 0.25);
  }
  .svc-title {
    font-family: var(--fran);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .svc-lede {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
  }
  .price-band {
    margin-top: 40px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    background: rgba(0, 201, 167, 0.05);
    border: 0.5px solid rgba(0, 201, 167, 0.3);
    border-radius: var(--radius);
    padding: 28px 32px;
  }
  .price-num {
    font-family: var(--fran);
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 600;
    color: var(--teal2);
    line-height: 1;
  }
  .price-num span {
    font-size: 0.4em;
    color: var(--muted);
  }
  .price-copy {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 560px;
  }
  .price-copy strong {
    color: var(--text);
  }
  @media (max-width: 820px) {
    .price-band {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
      gap: 16px;
    }
  }
</style>
