---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS } from '../consts';

// Standalone landing page for the free AI Risk Scan. Its single job is to
// sell the scan and funnel the visitor into /scan.html. Self-contained:
// all styles are scoped to this page, so it touches no existing page.

const SCAN_URL = '/scan.html';

const deliverables = [
  {
    k: 'Your AI Risk Score',
    d: 'A single 0–100 number for where your business stands today — the honest baseline most owners have never seen.',
  },
  {
    k: 'Your #1 finding',
    d: 'The single highest-priority exposure, specific to your industry, with a plain-English "what to do about it."',
  },
  {
    k: 'Shadow-AI exposure',
    d: 'A read on the AI tools your team may already be using without approval — and the compliance flags that come with them.',
  },
  {
    k: 'Recoverable hours',
    d: 'An estimate of the weekly hours quietly lost to repetitive admin that the right automation could give back.',
  },
];

const steps = [
  {
    n: '01',
    h: 'Answer a dozen plain questions',
    p: 'Written for business owners, not IT departments. No jargon, no logins, nothing to install.',
  },
  {
    n: '02',
    h: 'See your full report on screen',
    p: 'Your score, your findings, and what to do about each — computed instantly, right in the browser.',
  },
  {
    n: '03',
    h: 'Turn it into a plan (optional)',
    p: 'A free 30-minute review turns the report into a prioritized roadmap, with your first automation live within 30 days.',
  },
];

const faqs = [
  {
    q: 'Is the AI Risk Scan really free?',
    a: 'Yes. There is no cost, no credit card, and no obligation. You can see your AI Risk Score and top finding without even signing up — the full report unlocks with your contact details so our team can prepare recommendations before we ever reach out.',
  },
  {
    q: 'How long does it take?',
    a: 'About 90 seconds. It is roughly a dozen questions, each written so any business owner can answer without checking with anyone.',
  },
  {
    q: 'Do I need to be technical to take it?',
    a: 'No. The scan is built for non-technical owners and managers. Every question is in plain English, and your results are explained the same way — no vendor names, no acronyms.',
  },
  {
    q: 'What do I actually get at the end?',
    a: 'An on-screen report: your AI Risk Score out of 100, your exposure band, your compliance flags, an estimate of recoverable hours, and your top findings — each paired with a concrete next step. It renders instantly, even offline from our servers.',
  },
  {
    q: 'What happens to my answers?',
    a: 'They are used to generate your report and, if you unlock the full version, to prepare for a genuinely useful follow-up from a real person at AITS. No spam, and we never sell your information.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Free AI Risk Scan',
  serviceType: 'AI readiness and risk assessment',
  provider: { '@id': 'https://aits.llc/#organization' },
  areaServed: BUSINESS.areasServed,
  description:
    'A free 90-second AI readiness and risk scan for small businesses: an AI Risk Score, top findings with fixes, shadow-AI exposure, and recoverable-hours estimate — computed instantly on screen.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout
  title="Free AI Risk Scan"
  description="See what AI is already doing in your business in 90 seconds. Free AI Risk Scan for small businesses: your AI Risk Score, top findings with fixes, shadow-AI exposure, and recoverable hours — instant, on screen, no signup to start."
  path="/ai-scan"
  schemas={[serviceSchema, faqSchema]}
  landing
>
  <!-- HERO -->
  <section class="lp-hero">
    <div class="container lp-hero-grid">
      <div class="lp-hero-copy">
        <span class="lp-eyebrow">Free · 90 seconds · No signup to start</span>
        <h1>
          Find out what AI is <em>already</em> doing in your business.
        </h1>
        <p class="lp-lede">
          Your team may already be using AI tools no one approved. The free AI Risk Scan shows you
          exactly where you're exposed, what it's quietly costing you, and the single highest-value
          fix — on screen, in about 90 seconds.
        </p>
        <div class="lp-actions">
          <a href={SCAN_URL} class="lp-cta" data-cta="ai-scan-hero"
            >Run my free AI scan <span aria-hidden="true">→</span></a
          >
          <a href="#what-you-get" class="lp-cta-ghost" data-cta="ai-scan-seewhat">See what you get</a>
        </div>
        <p class="lp-gate-note">
          See your score and #1 finding free — the full report unlocks with your email.
        </p>
        <ul class="lp-trust-row">
          <li>No card required</li>
          <li>Instant results</li>
          <li>Built by AITS</li>
        </ul>
      </div>

      <!-- Score preview card (illustrative) -->
      <aside class="lp-score-card" aria-label="Example AI Risk Scan result">
        <div class="lp-score-head">
          <span class="lp-score-label">AI Risk Score</span>
          <span class="lp-score-band">ELEVATED</span>
        </div>
        <div class="lp-score-num"><span>63</span><small>/ 100</small></div>
        <div class="lp-score-bar"><span style="width:63%"></span></div>
        <div class="lp-score-tiles">
          <div><small>Shadow AI</small><strong>High</strong></div>
          <div><small>Flags</small><strong>3</strong></div>
          <div><small>Hrs / wk</small><strong>12–30</strong></div>
        </div>
        <p class="lp-score-note">Illustrative result. Yours is computed from your answers.</p>
      </aside>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section id="what-you-get" class="lp-section">
    <div class="container">
      <span class="lp-section-label">What you'll walk away with</span>
      <h2 class="lp-section-heading">Four answers, in ninety seconds.</h2>
      <div class="lp-cards">
        {
          deliverables.map((d) => (
            <div class="lp-card">
              <h3>{d.k}</h3>
              <p>{d.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="lp-section lp-section--alt">
    <div class="container">
      <span class="lp-section-label">How it works</span>
      <h2 class="lp-section-heading">No consultants. No install. Just answers.</h2>
      <ol class="lp-steps">
        {
          steps.map((s) => (
            <li class="lp-step">
              <span class="lp-step-num">{s.n}</span>
              <div>
                <h3>{s.h}</h3>
                <p>{s.p}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- MID CTA -->
  <div class="lp-midcta">
    <a href={SCAN_URL} class="lp-cta" data-cta="ai-scan-mid"
      >Run my free AI scan <span aria-hidden="true">→</span></a
    >
  </div>

  <!-- WHY / TRUST -->
  <section class="lp-section">
    <div class="container lp-why">
      <div class="lp-why-copy">
        <span class="lp-section-label">Why it's worth 90 seconds</span>
        <h2 class="lp-section-heading">Most AI works on day one. The risk shows up later.</h2>
        <p>
          The tools your team adopts on their own don't come with a security review. They just
          start handling your customer data, your documents, your workflows — and by the time
          something goes wrong, it's a problem, not a finding. The scan surfaces it while it's
          still just a finding.
        </p>
        <p>
          AITS was built on <strong>25+ years</strong> of deploying and managing technology that
          has to work every day — tested on a schedule, monitored continuously, one flat monthly
          fee. We profit when nothing breaks. The scan is where that starts: a clear, honest
          picture, no strings attached.
        </p>
      </div>
      <ul class="lp-why-points">
        <li><strong>25+ years</strong> keeping business technology working</li>
        <li><strong>One flat fee</strong> — we're paid to prevent problems, not bill them</li>
        <li><strong>San Diego HQ</strong>, serving businesses nationwide</li>
        <li><strong>Real people</strong> — a human reviews your results, not a bot</li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="lp-section lp-section--alt">
    <div class="container lp-faq-wrap">
      <span class="lp-section-label">Questions, answered</span>
      <h2 class="lp-section-heading">Before you start</h2>
      <div class="lp-faq">
        {
          faqs.map((f) => (
            <details class="lp-faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="lp-final">
    <div class="container lp-final-inner">
      <h2>See your AI Risk Score in 90 seconds.</h2>
      <p>
        See your score and top finding free — the full report unlocks with your email. No card, no
        obligation.
      </p>
      <a href={SCAN_URL} class="lp-cta lp-cta--lg" data-cta="ai-scan-final"
        >Run my free AI scan <span aria-hidden="true">→</span></a
      >
      <p class="lp-final-fine">
        Prefer to talk first?
        <a href="/contact" data-cta="ai-scan-contact-final">Book a free 30-minute assessment</a>
        instead.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Scoped to the AI Scan landing page. Deep-blue accent for text-bearing
     fills (white clears WCAG AA), plus a page-local focus ring so keyboard
     users always see where they are. */
  .lp-hero,
  .lp-section,
  .lp-final {
    --lp-accent-deep: #2d5cd8;
  }
  .lp-hero :focus-visible,
  .lp-section :focus-visible,
  .lp-final :focus-visible {
    outline: 2px solid var(--accent2);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* ---------- Hero ---------- */
  .lp-hero {
    padding-block: clamp(56px, 9vw, 104px);
    background: rgba(7, 9, 15, 0.66);
    backdrop-filter: blur(2px);
  }
  .lp-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .lp-eyebrow {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teal2);
    background: var(--tdim);
    border: 0.5px solid rgba(0, 201, 167, 0.25);
    padding: 6px 12px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .lp-hero h1 {
    font-family: var(--fran);
    font-size: clamp(34px, 5vw, 58px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .lp-hero h1 em {
    font-style: italic;
    color: var(--accent2);
  }
  .lp-lede {
    font-size: clamp(16px, 1.7vw, 19px);
    line-height: 1.65;
    color: var(--text2);
    max-width: 560px;
    margin-top: 20px;
  }
  .lp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }
  .lp-cta {
    display: inline-block;
    /* Both gradient stops clear WCAG AA for white text (>=4.5:1) — the lighter
       --accent (4.49:1 at the corner) is nudged to #3462e6 so scanners pass. */
    background: linear-gradient(135deg, #3462e6, var(--lp-accent-deep));
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    padding: 15px 28px;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(59, 110, 240, 0.4);
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }
  .lp-cta:hover {
    transform: translateY(-2px);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 12px 40px rgba(59, 110, 240, 0.55);
  }
  .lp-cta--lg {
    font-size: 17px;
    padding: 18px 36px;
  }
  .lp-cta-ghost {
    display: inline-block;
    padding: 15px 24px;
    border-radius: 12px;
    border: 1px solid var(--border3);
    color: var(--text2);
    font-weight: 500;
    font-size: 15px;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .lp-cta-ghost:hover {
    color: var(--text);
    border-color: var(--accent2);
    background: rgba(100, 120, 200, 0.08);
    text-decoration: none;
  }
  .lp-gate-note {
    font-size: 13px;
    color: var(--muted);
    margin-top: 14px;
  }
  .lp-trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
  }
  .lp-trust-row li {
    font-size: 13px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .lp-trust-row li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
    flex-shrink: 0;
  }

  /* ---------- Hero score card ---------- */
  .lp-score-card {
    background: linear-gradient(160deg, rgba(18, 22, 38, 0.92), rgba(12, 15, 26, 0.92));
    border: 1px solid var(--border3);
    border-radius: 20px;
    padding: 26px 26px 20px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
  }
  .lp-score-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .lp-score-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .lp-score-band {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #ffce54;
    background: rgba(255, 206, 84, 0.12);
    border: 0.5px solid rgba(255, 206, 84, 0.3);
    padding: 3px 10px;
    border-radius: 100px;
  }
  .lp-score-num {
    font-family: var(--fran);
    font-weight: 600;
    color: var(--text);
    line-height: 1;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .lp-score-num span {
    font-size: 68px;
  }
  .lp-score-num small {
    font-size: 16px;
    color: var(--muted);
    font-family: var(--jak);
  }
  .lp-score-bar {
    height: 8px;
    border-radius: 100px;
    background: rgba(100, 120, 200, 0.16);
    margin: 16px 0 20px;
    overflow: hidden;
  }
  .lp-score-bar span {
    display: block;
    height: 100%;
    border-radius: 100px;
    background: linear-gradient(90deg, var(--accent), #ffce54);
  }
  .lp-score-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .lp-score-tiles div {
    background: rgba(7, 9, 15, 0.5);
    border: 0.5px solid var(--border2);
    border-radius: 10px;
    padding: 10px;
    text-align: center;
  }
  .lp-score-tiles small {
    display: block;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .lp-score-tiles strong {
    font-size: 15px;
    color: var(--text);
  }
  .lp-score-note {
    font-size: 11px;
    color: var(--muted);
    text-align: center;
    margin-top: 14px;
  }

  /* ---------- Generic sections ---------- */
  .lp-section {
    padding-block: clamp(56px, 8vw, 88px);
    background: rgba(7, 9, 15, 0.74);
    backdrop-filter: blur(2px);
  }
  .lp-section--alt {
    background: rgba(10, 13, 22, 0.82);
  }
  .lp-section-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--teal2);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .lp-section-heading {
    font-family: var(--fran);
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--text);
    max-width: 720px;
    margin-bottom: 40px;
  }

  /* ---------- Deliverable cards ---------- */
  .lp-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
  }
  .lp-card {
    background: rgba(12, 15, 26, 0.8);
    border: 0.5px solid var(--border2);
    border-radius: 16px;
    padding: 26px 24px;
    transition: border-color 0.25s, transform 0.25s;
  }
  .lp-card:hover {
    border-color: rgba(59, 110, 240, 0.5);
    transform: translateY(-4px);
  }
  .lp-card h3 {
    font-family: var(--fran);
    font-size: 19px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }
  .lp-card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted);
  }

  /* ---------- Steps ---------- */
  .lp-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .lp-midcta {
    text-align: center;
    padding: 8px 5vw 0;
  }
  .lp-step {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background: rgba(12, 15, 26, 0.6);
    border: 0.5px solid var(--border2);
    border-radius: 16px;
    padding: 24px 26px;
  }
  .lp-step-num {
    font-family: var(--fran);
    font-size: 22px;
    font-weight: 600;
    color: var(--accent2);
    background: var(--aglow);
    border: 0.5px solid rgba(59, 110, 240, 0.28);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .lp-step h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 6px;
  }
  .lp-step p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
  }

  /* ---------- Why / trust ---------- */
  .lp-why {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }
  .lp-why-copy p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text2);
    margin-top: 14px;
    max-width: 620px;
  }
  .lp-why-copy strong {
    color: var(--text);
  }
  .lp-why-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .lp-why-points li {
    font-size: 15px;
    color: var(--text2);
    line-height: 1.5;
    padding-left: 28px;
    position: relative;
  }
  .lp-why-points strong {
    color: var(--text);
  }
  .lp-why-points li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--teal2);
    font-weight: 700;
  }

  /* ---------- FAQ ---------- */
  .lp-faq-wrap {
    max-width: 820px;
  }
  .lp-faq {
    display: grid;
    gap: 10px;
  }
  .lp-faq-item {
    background: rgba(12, 15, 26, 0.6);
    border: 0.5px solid var(--border2);
    border-radius: 12px;
    padding: 4px 20px;
  }
  .lp-faq-item summary {
    cursor: pointer;
    padding: 16px 0;
    font-weight: 600;
    font-size: 16px;
    color: var(--text);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .lp-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .lp-faq-item summary::after {
    content: '+';
    color: var(--accent2);
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .lp-faq-item[open] summary::after {
    transform: rotate(45deg);
  }
  .lp-faq-item p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text2);
    padding: 0 0 18px;
    margin: 0;
    max-width: 70ch;
  }

  /* ---------- Final CTA ---------- */
  .lp-final {
    padding-block: clamp(64px, 9vw, 104px);
    background:
      radial-gradient(ellipse 80% 120% at 50% 0%, rgba(59, 110, 240, 0.14), transparent 60%),
      rgba(8, 11, 20, 0.9);
    text-align: center;
  }
  .lp-final-inner h2 {
    font-family: var(--fran);
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.12;
    color: var(--text);
    max-width: 640px;
    margin: 0 auto;
  }
  .lp-final-inner > p {
    font-size: 17px;
    color: var(--text2);
    margin: 16px auto 30px;
    max-width: 480px;
  }
  .lp-final-fine {
    font-size: 14px;
    color: var(--muted);
    margin-top: 22px;
  }
  .lp-final-fine a {
    color: var(--accent2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 860px) {
    .lp-hero-grid,
    .lp-why {
      grid-template-columns: 1fr;
    }
    .lp-score-card {
      order: -1;
      max-width: 420px;
      margin-inline: auto;
    }
  }
  @media (max-width: 520px) {
    .lp-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .lp-cta,
    .lp-cta-ghost {
      text-align: center;
    }
    .lp-step {
      flex-direction: column;
      gap: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-cta,
    .lp-card,
    .lp-faq-item summary::after {
      transition: none;
    }
  }
</style>
