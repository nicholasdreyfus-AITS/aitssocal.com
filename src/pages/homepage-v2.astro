---
import BaseLayout from '../layouts/BaseLayout.astro';
import BorderBeam from '../components/BorderBeam.astro';
import { SITE } from '../consts';

// Capability groups — what an AITS partnership changes for the CLIENT'S
// business, organized by the customer journey. Every line is a client
// outcome first, mechanism second. Never names the underlying platform.
const capabilityGroups = [
  {
    label: 'Capture every lead',
    icon: '🎯',
    items: [
      { name: 'Every call answered — 24/7', desc: 'An AI receptionist and website chat greet, qualify, and book callers at 2 pm or 2 am' },
      { name: 'A missed call is no longer a lost job', desc: 'The customer gets an instant text back — before they dial your competitor' },
      { name: 'Your website books work while you sleep', desc: 'Designed to look great, built to function — and built to turn visitors into appointments' },
      { name: 'Found on Google — and by AI', desc: 'Real search engine optimization plus AI-search optimization, so customers discover you however they search' },
    ],
  },
  {
    label: 'Convert them to customers',
    icon: '📈',
    items: [
      { name: 'No lead ever goes cold', desc: 'Automated follow-up keeps the conversation alive until they book — or tell you no' },
      { name: 'Every lead tracked to close', desc: 'One pipeline from first touch to won job — nothing forgotten in an inbox' },
      { name: 'Customers book themselves', desc: 'Online scheduling with reminders that cut no-shows' },
      { name: 'Your marketing runs without you', desc: 'Email and SMS campaigns go out consistently — no late nights writing blasts' },
    ],
  },
  {
    label: 'Get paid & keep them',
    icon: '💳',
    items: [
      { name: 'Quotes out same day, paid faster', desc: 'Estimates, invoices, and payments in one place — from yes to money in the bank' },
      { name: 'Your reputation compounds', desc: 'Happy customers become 5-star reviews, automatically' },
      { name: 'You show up online every week', desc: 'Social presence on autopilot — zero staff hours spent' },
    ],
  },
  {
    label: 'See what is working',
    icon: '🧭',
    items: [
      { name: 'One inbox, nothing missed', desc: 'Calls, texts, emails, and DMs in a single thread your team can actually manage' },
      { name: "Know what's making you money", desc: 'Dashboards and call tracking that prove which marketing actually pays' },
      { name: 'Your whole business in your pocket', desc: 'Run it all from the mobile app, wherever the day takes you' },
    ],
  },
];

// The manifesto — why AITS is different, from the ground up. This is the
// site's spine: hero leads with it, this section carries it, services/about
// echo it, and the closing CTA lands on it.
const convictions = [
  {
    h: "We've done this for 25+ years",
    p: 'Onboarding, integrating, deploying, and managing software, hardware, and full solutions — so they are reliable, they actually work, and they are properly tested regularly. AI is our newest tool, not our first rodeo.',
  },
  {
    h: "Day one isn't the finish line",
    p: 'Most AI deployments break by week two or three, when one of the tools underneath pushes an update and a connection quietly snaps. We proactively test your website, your forms, your CRM, your automations — on a schedule — because updates never stop. When a platform like YouTube changes its rules overnight, we would rather find it before you do.',
  },
  {
    h: 'We profit when nothing breaks',
    p: 'One monthly fee, fixes included. Every "it\'s broken" call costs us, not you — so we are incentivized to fix things right the first time, and to engineer them so you never have to call at all.',
  },
  {
    h: 'We grow when you grow',
    p: 'As your business scales, you need more automation to keep your team on the work that drives revenue — not the busywork pulling them away from it. We add those services as you grow. That is the partnership.',
  },
];

const vsThem = [
  'Deploy it, demo it, disappear',
  'An update breaks a link by week three',
  'You find out when a customer does',
  'Every fix is a new invoice',
  'They profit when it breaks',
];

const vsUs = [
  '25+ years deploying and managing technology',
  'Every automation tested on a schedule',
  'Breaks caught before you feel them',
  'One flat fee — fixes included',
  "We profit when it doesn't",
];

const faqs = [
  {
    q: 'What makes AITS different from other AI companies?',
    a: 'Most AI companies are new to running technology that has to work every day. AITS was built from the ground up on 25+ years of onboarding, integrating, deploying, and managing software, hardware, and full solutions. That experience shows up as discipline: everything we deploy is tested regularly, monitored continuously, and covered by one flat monthly fee — so our incentive is to keep things working, not to bill you when they break.',
  },
  {
    q: 'Why do AI automations break a few weeks after they are deployed?',
    a: 'Because the tools underneath them never stop changing. An automation is usually several pieces of software connected together — and when any one of them pushes an update, or a platform like YouTube changes a rule overnight, a connection can quietly break. Most vendors deploy something that works on day one and leave; by week two or three something snaps, you find out when a customer does, and you get charged for every fix. AITS runs proactive maintenance instead: we test your website, your forms, your booking, your CRM, and every automation on a schedule — because we would rather find the problem before you do, and fix it right the first time.',
  },
  {
    q: 'Do you build websites?',
    a: 'Yes — but not the way most shops do. Anyone can build a website that looks great; we build sites that look great, function flawlessly, and are engineered to be found: proper search engine optimization plus AI-search optimization, so customers discover you on Google and through the AI assistants people increasingly ask for recommendations. Then the ecosystem takes over — every visitor who hits your website or social gets cultivated with chat, follow-up, and booking, so traffic turns into customers instead of bouncing. And like everything we deploy, your site, forms, and integrations are proactively tested so they keep working.',
  },
  {
    q: 'How much does it cost for a small business to deploy AI?',
    a: "It's bespoke to what your business actually needs, but here's the shape of it. Step one — your website and brand redesign — starts at $750 one-time, and you do not pay until you are happy with it, or you can walk away anytime. Already like your current site and logo? You can skip straight to step two. Monthly plans start at $297 a month and do not begin until step one is complete and approved, so you are only ever paying for the website work until you are ready to move forward. On top of that you add only what you need: search engine and AI-search optimization from $450 a month, social media management from $550 a month, and an AI receptionist from $450 a month. It starts with a free 30-minute assessment so you see the real numbers for your business before spending a dollar, and every monthly engagement is month-to-month with no lock-in.",
  },
  {
    q: 'What is included in the one monthly fee?',
    a: 'Everything: the full platform (CRM and pipeline, email and SMS marketing, AI receptionist and chat, appointment booking, review management, missed-call text-back, websites and funnels, reporting), plus a dedicated engineering team that builds your automations, tests them on a regular schedule, monitors uptime, and jumps on issues the moment something breaks. You are not buying tools — you are gaining a partner.',
  },
  {
    q: 'Why is one fee with AITS less expensive than buying the tools myself?',
    a: 'AITS partners directly with enterprise-grade technology providers at a scale no single small business could reach. Those partnerships come with considerable discounts, and we pass them through — which is why one competitive monthly fee covers the entire platform and the engineering time to keep it working, usually for less than the pile of separate subscriptions it replaces. The bigger picture: you get the ecosystem a mid-sized organization runs on — often at a tenth of what it would cost to assemble and staff it yourself.',
  },
  {
    q: 'Who manages the tools after they are set up?',
    a: 'We do — that is the point. Most businesses buy software and become their own unpaid IT department, or get billed by their vendor every time something breaks. With AITS, your automations are tested regularly, uptime is monitored, and when anything needs attention our engineers handle it at no extra charge — the flat fee means we are incentivized to reduce the number of times you ever have to call us. You run your business; we run the technology.',
  },
  {
    q: 'How long until we see results from AI?',
    a: 'Our model is built around a visible win in the first 30 days. We deploy your highest-value automation first — often something like an AI receptionist, scheduling, or meeting prep — so the whole team feels the benefit fast.',
  },
  {
    q: 'Will AI replace my employees?',
    a: 'No. AI does not replace your people — it replaces their worst tasks. We automate the repetitive grunt work your team hates so your experts can focus on the high-value work they were actually hired to do.',
  },
  {
    q: 'Is it safe to use AI with our business data?',
    a: 'Only if it is deployed correctly. We set up a secure, governed AI environment with clear policy, access controls, and monitoring — so your team gets the productivity gains without leaking client data, financials, or IP into public tools.',
  },
  {
    q: 'Do we need a big IT team or budget to start?',
    a: 'No. AITS is built specifically for small and mid-sized businesses without a dedicated IT department. We handle the strategy, deployment, and team training, and it starts with a free assessment.',
  },
  {
    q: 'What areas does AITS serve?',
    a: 'AITS is headquartered in San Diego and serves businesses across the entire United States. We are local to Southern California when something needs a human on-site, and remote-first everywhere else — most of what we deploy and manage runs the same no matter where your business operates.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Service schema — describes the all-in-one managed platform as a single
// offering for one flat fee. High-value for AEO: it's what answer engines
// lift for "all-in-one platform for small business" / "managed CRM and
// marketing for one fee" style questions.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'All-in-One Managed Business Platform',
  serviceType: 'Managed business technology and AI platform',
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'United States' },
  description:
    'Every call answered 24/7 by an AI receptionist, missed calls texted back instantly, automated follow-up so no lead goes cold, self-service scheduling with reminders, same-day estimates and invoicing with payments, automatic review generation, consistent email, SMS, and social presence, a unified inbox, and dashboards that show which marketing pays — delivered as one managed platform for one flat monthly fee that includes engineering, regular testing, uptime monitoring, and fixes. Built on 25+ years of deploying and managing business technology.',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '297',
    description:
      'Monthly plans start at $297 per month once your website and brand step is complete — covering the lead system, proactive testing, and fixes. Website and brand redesign starts at $750 one-time. Optional add-ons: search and AI-search optimization from $450 per month, social media management from $550 per month, and AI receptionist from $450 per month.',
    availability: 'https://schema.org/InStock',
  },
};

const results = [
  {
    icon: '📞',
    tag: 'AI Receptionist',
    hl: true,
    title: 'A local SD business never misses a lead again',
    desc: 'Their AI receptionist answers every call, qualifies the caller, captures key information, and schedules the right next step — 24 hours a day, without a single staff member involved.',
    big: '24/7',
    lbl: 'coverage with zero added headcount',
  },
  {
    icon: '📅',
    tag: 'Appointment automation',
    title: "Scheduling removed from the team's plate entirely",
    desc: 'Scheduling, confirmation, reminders, and pre-meeting information gathering all automated. Staff stopped doing this manually within the first 30 days of deployment.',
    big: '<30',
    lbl: 'days from kickoff to live automation',
  },
  {
    icon: '📱',
    tag: 'Social media',
    title: 'Consistent brand presence without a marketing hire',
    desc: 'Content creation, scheduling, and brand awareness running on autopilot. The business shows up professionally online every week without anyone on staff spending time on it.',
    big: '0hrs',
    lbl: 'of staff time per week on social content',
  },
  {
    icon: '📋',
    tag: 'Meeting prep',
    title: 'Every meeting starts with the right information already gathered',
    desc: 'AI handles pre-meeting intake, collects needed documents and context, and delivers a clean brief before the meeting starts. No more back-and-forth emails chasing information.',
    big: '100%',
    lbl: 'of meetings arrive with full context ready',
  },
];

const steps = [
  { n: '01', h: 'We ask your team what they hate doing', p: 'Not what you want automated — what they want automated. Those become our first targets.' },
  { n: '02', h: 'We deliver a visible win in the first 30 days', p: 'One meaningful automation, live and working, fast enough that the whole team sees the value before skepticism has time to set in.' },
  { n: '03', h: 'We train your team to work with AI, not around it', p: 'Your people learn to use these tools with confidence. They stop feeling like bystanders and start feeling like they have a superpower at work.' },
  { n: '04', h: 'We scale with a team that is now pulling for it', p: 'Phase two goes faster because your team is requesting new automations, not resisting them.' },
];

const services = [
  { icon: '🤖', feat: true, href: '/services#automation', title: 'AI Integration & Deployment', desc: 'We identify, build, and deploy the highest-leverage AI automations for your workflows. Receptionists, scheduling, content, intake, reporting and more — all with measurable outcomes attached.', tags: ['Workflow automation', 'AI receptionist', 'Custom tools'], bullets: ['An AI receptionist answering your calls 24/7', 'Every automation tested on a schedule — fixes included', 'Live inside 30 days, with a measurable outcome'] },
  { icon: '🗺️', href: '/services#assessment', title: 'AI Strategy & Roadmap', desc: 'A structured assessment of your operation that identifies your top AI opportunities, estimates ROI for each, and gives you a phased deployment plan. Starts free.', tags: ['Free to start', 'ROI-backed plan'], bullets: ['Free 30-minute assessment to start', 'Shadow-AI and compliance exposure scored', 'Every recommendation ranked by ROI'] },
  { icon: '📢', href: '/services#websites', title: 'AI Marketing & Brand Automation', desc: 'Social media content, brand awareness campaigns, and lead nurturing on autopilot. Professional presence without a full-time marketing hire.', tags: ['Social media', 'Content creation', 'Brand awareness'], bullets: ['SEO plus AI-search optimization so you get found', 'Social presence on autopilot — zero staff hours', 'Visitors cultivated into booked appointments'] },
  { icon: '🖥️', teal: true, href: '/services#support', title: 'Managed IT Infrastructure', desc: 'Computers, servers, networks, and security — the foundation your AI tools run on. Month-to-month, local support when you need a human on-site.', tags: ['Computers', 'Servers', 'Security'], bullets: ['Proactively monitored and maintained', 'Security built for small-business exposure', 'On-site support across Southern California'] },
];

const process = [
  { n: '01', h: 'Free AI assessment', p: '30 minutes. We map your workflows, understand where time is being lost, and listen to what your team wants off their plate.', badge: 'Free, no obligation' },
  { n: '02', h: 'Opportunity report', p: 'You receive a prioritized list of AI opportunities ranked by ROI, with clear investment and outcome projections for each one.' },
  { n: '03', h: 'First automation live', p: 'We deploy your highest-value automation first, with a goal to have it live and delivering results inside the first 30 days.' },
  { n: '04', h: 'Scale with your team', p: 'With an early win behind us and your team on board, we expand into the next opportunities — faster, because momentum is on your side.' },
];

const team = [
  { img: '/images/gavin.jpg', pos: 'center 28%', role: 'Founder & Principal', roleClass: 'ceo', name: 'Gavin Dreyfus', title: 'Founder & Principal', bio: "Gavin founded AITS with a clear conviction: AI should be accessible to every small business, not just enterprise companies with dedicated IT departments. As Founder and Principal, he leads day-to-day client strategy and operations, deploying AI quickly and practically for SMB owners who need results, not roadmaps." },
  { img: '/images/nick.jpg', pos: 'center 20%', role: 'Co-Founder & Board Member', roleClass: 'board', name: 'Nick Dreyfus', title: 'Co-Founder, Board Member & VP of Business Development, i-NETT', bio: 'Nick brings over twelve years as a systems administrator and a decade of consulting and network architecture experience to the AITS board. As VP of Business Development at i-NETT, he approaches every client relationship from a position of technical authority — educating and strategizing the way an in-house CTO would.', linkedin: 'https://www.linkedin.com/in/nicholas-dreyfus/' },
  { img: '/images/dale.png', pos: 'center 15%', role: 'Board Member', roleClass: 'board', name: 'Dale Stein', title: 'Board Member • CEO, LensLock • CEO, Technology Assurance Group • Partner, i-NETT', bio: 'Dale Stein is one of the most recognized names in managed technology services in North America. As CEO of LensLock and TAG, and Partner at i-NETT, he leads organizations representing over $1 billion in combined annual products and services.', linkedin: 'https://www.linkedin.com/in/steindale/' },
];
---

<BaseLayout
  title="AITS — v2 test"
  description="Everything your small business runs on — CRM, AI receptionist, booking, reporting — one managed platform, one flat fee. Serving businesses nationwide."
  path="/homepage-v2"
  schemas={[serviceSchema, faqSchema]}
  noindex
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-left">
      <div class="hero-badge"><span class="badge-dot"></span>Built differently — from the ground up</div>
      <h1>Anyone can launch AI that works on day one.<br /><em>Ours still works in month three.</em></h1>
      <div class="hero-divider"></div>
    </div>
    <BorderBeam alwaysOn={true} dual={true} class="hero-box" tag="div">
      <p class="hero-sub">
        AITS was built on 25+ years of onboarding, integrating, deploying, and managing technology
        that has to work. One flat monthly fee covers the tools <em>and</em> the team that tests,
        monitors, and fixes them — so we profit when nothing breaks, not when everything does.
      </p>
      <p class="hero-name">Headquartered in San Diego • Serving businesses nationwide</p>
      <div class="hero-actions">
        <a href="/contact" class="btn-primary">Start your AI automation journey</a>
        <a href="#results" class="btn-ghost">See real results</a>
      </div>
    </BorderBeam>
  </section>

  <!-- STAGES: the 3-stage growth path (v2 test) -->
  <section class="section stages">
    <div class="container">
      <span class="section-label" style="text-align:center;display:block">How we take you from invisible to growing</span>
      <h2 class="section-heading" style="text-align:center;margin-inline:auto">Three steps. One partner the whole way.</h2>
      <p class="section-sub" style="text-align:center;margin-inline:auto">
        We meet you wherever you are today and build in the order that actually works — a site
        that can convert, a process that never drops a lead, then the visibility to fill the top
        of the funnel.
      </p>
      <div class="stage-grid" data-beam-group>
        <BorderBeam active={true} alwaysOn={true} dual={true} class="stage-card featured" tabindex="0">
          <span slot="badge" class="stage-start-badge">Start here</span>
          <div class="stage-num">STEP 01</div>
          <h3>Website & brand</h3>
          <p>A site built to convert, not just to look good — redesigned and rebranded if yours isn't pulling its weight yet.</p>
          <p class="stage-note">Already love your site and logo? Keep it — skip straight to step two.</p>
          <span class="stage-price">Starting at $750 <small>one-time</small></span>
          <span class="stage-guarantee">You don't pay until you're happy with the website and logo — or walk away anytime.</span>
        </BorderBeam>
        <div class="stage-arrow" aria-hidden="true">→</div>
        <BorderBeam dual={true} class="stage-card" tabindex="0">
          <div class="stage-num">STEP 02</div>
          <h3>Never miss another lead</h3>
          <p>A real process behind every call, email, and text — captured, tracked, and followed up automatically so nothing falls through the cracks again.</p>
          <span class="stage-guarantee">Month-to-month. Cancel anytime.</span>
        </BorderBeam>
        <div class="stage-arrow" aria-hidden="true">→</div>
        <BorderBeam dual={true} class="stage-card" tabindex="0">
          <div class="stage-num">STEP 03</div>
          <h3>Get found, get growing</h3>
          <p>SEO, AEO, and social — built once the foundation can actually convert what it brings in, so growth compounds instead of leaking away.</p>
          <span class="stage-guarantee">Month-to-month. Cancel anytime.</span>
        </BorderBeam>
      </div>
    </div>
  </section>

  <script>
    // Border-beam transfer: exactly one card per data-beam-group shows the
    // traveling beam at a time. Defaults to whichever card server-rendered
    // with data-beam-active="true" (the featured card); hover/focus on any
    // sibling moves the beam there and back on leave. Keyboard focus behaves
    // the same as hover. Touch devices without hover simply never fire these
    // events, so the beam just stays on the default card, per spec.
    document.querySelectorAll('[data-beam-group]').forEach((group) => {
      const cards = Array.from(group.querySelectorAll(':scope > .beam-card'));
      const defaultCard = cards.find((c) => c.dataset.beamActive === 'true') ?? cards[0];
      if (!defaultCard) return;

      const activate = (card) => {
        cards.forEach((c) => {
          c.dataset.beamActive = c === card ? 'true' : 'false';
        });
      };

      cards.forEach((card) => {
        card.addEventListener('mouseenter', () => activate(card));
        card.addEventListener('focusin', () => activate(card));
        card.addEventListener('mouseleave', () => activate(defaultCard));
        card.addEventListener('focusout', (e) => {
          if (!card.contains(e.relatedTarget)) activate(defaultCard);
        });
      });
    });
  </script>

  <hr class="divider" />

  <!-- PROOF BAR -->
  <div class="proof-bar">
    <div class="container proof-inner">
      <div class="proof-item"><span class="proof-dot"></span>25+ years deploying &amp; managing business technology</div>
      <div class="proof-item"><span class="proof-dot"></span>Every automation tested on a schedule</div>
      <div class="proof-item"><span class="proof-dot"></span>One flat monthly fee — fixes included</div>
      <div class="proof-item"><span class="proof-dot"></span>No long-term contracts, ever</div>
    </div>
  </div>

  <!-- MANIFESTO: WHY WE'RE DIFFERENT -->
  <section class="section" id="different">
    <div class="container">
      <span class="section-label">Why we're different</span>
      <h2 class="section-heading">We do things differently.<br /><em class="hl-em">From the ground up.</em></h2>
      <p class="section-sub">
        The demo is always impressive. Then week two or three arrives: one of the tools underneath
        pushes an update, a connection quietly breaks, and nobody on your team knows how to fix it.
        So you call the company that built it — and they charge you. Every single time.
      </p>

      <div class="vs-grid">
        <div class="vs-card vs-them">
          <p class="vs-label">Most AI companies</p>
          <ul>
            {vsThem.map((line, i) => <li class:list={[{ 'vs-final': i === vsThem.length - 1 }]}>{line}</li>)}
          </ul>
        </div>
        <div class="vs-card vs-us">
          <p class="vs-label">The AITS partnership</p>
          <ul>
            {vsUs.map((line, i) => <li class:list={[{ 'vs-final': i === vsUs.length - 1 }]}>{line}</li>)}
          </ul>
        </div>
      </div>

      <div class="promise-grid">
        {
          convictions.map((c, i) => (
            <div class="promise-card">
              <div class="promise-num">{String(i + 1).padStart(2, '0')}</div>
              <h3>{c.h}</h3>
              <p>{c.p}</p>
            </div>
          ))
        }
      </div>

      <p class="manifesto-close">
        Our incentive is simple: reduce the number of times you ever have to call us.
        <em>That is what a real technology partnership looks like.</em>
      </p>
    </div>
  </section>

  <hr class="divider" />

  <!-- ONE PLATFORM, ONE FEE -->
  <section class="section" id="platform">
    <div class="container">
      <span class="section-label">The AITS model</span>
      <h2 class="section-heading">One partner replaces your entire stack.<br /><em class="hl-em">One fee. Everything below.</em></h2>
      <p class="section-sub">
        Forget the feature list — here is what actually changes in your business. Every phone call
        answered. Every lead followed up. Every invoice out the door faster. Not a pile of tools —
        an entire ecosystem, built so your company functions like a mid-sized organization or
        larger, at a fraction of what it would cost to build and staff yourself:
      </p>
      <div class="cap-groups">
        {
          capabilityGroups.map((g) => (
            <div class="cap-group">
              <div class="cap-group__head">
                <span class="cap-group__icon" aria-hidden="true">{g.icon}</span>
                <h3 class="cap-group__title">{g.label}</h3>
              </div>
              <ul class="cap-list">
                {g.items.map((it) => (
                  <li>
                    <span class="cap-name">{it.name}</span>
                    <span class="cap-desc">{it.desc}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="cap-tagline">
        Fourteen jobs your business needs done — one login, one bill, and one team accountable for
        all of it. Everything a company ten times your size has, without ten times the cost.
      </p>

      <div class="how-note">
        <strong>How is all of this one fee?</strong> AITS partners directly with enterprise-grade
        technology providers — partnerships at a scale no single small business could reach on its
        own. Those relationships come with considerable discounts, and we pass them through. That
        is why one competitive monthly fee covers the entire platform <em>and</em> the engineering
        time to keep everything working: built, tested regularly, monitored, and fixed the moment
        anything needs attention. <strong>Pricing is bespoke to what your business needs</strong> —
        see the FAQ below for how it breaks down, or get a free assessment for real numbers.
      </div>

      <div class="more">
        <a href="/contact" class="btn-primary">Book a free exploratory call</a>
        <p class="more-note">30 minutes, no pitch. We will map which of these would move the needle for your business first — and what it would take to turn it on.</p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- RESULTS -->
  <section class="section" id="results">
    <div class="container">
      <span class="section-label">Real outcomes, real businesses</span>
      <h2 class="section-heading">We do not run pilots. We deliver results.</h2>
      <p class="section-sub">Every engagement starts with an early win your entire team can see and feel.</p>
      <div class="grid-auto">
        {
          results.map((r) => (
            <div class:list={['card', { hl: r.hl }]}>
              <span class="result-icon">{r.icon}</span>
