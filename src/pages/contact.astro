---
import BaseLayout from '../layouts/BaseLayout.astro';
import BorderBeam from '../components/BorderBeam.astro';
import { BUSINESS } from '../consts';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact AITS',
  description: 'Book a free AI assessment with AITS. Most plans start at $297/month.',
};

const expect = [
  { n: '01', h: 'We listen first', p: 'You talk, we map: where time is being lost, what your team hates doing, what growth is stuck behind.' },
  { n: '02', h: 'You get a real plan', p: 'A prioritized list of AI opportunities ranked by ROI — yours to keep whether we work together or not.' },
  { n: '03', h: 'A win in 30 days', p: 'If we do work together, your highest-value automation goes live fast enough for the whole team to feel it.' },
];
---

<BaseLayout
  title="Contact"
  description="Book a free AI assessment with AITS. No pitch, no jargon — a real plan you can act on immediately. Most plans start at $297/month. San Diego HQ, serving businesses nationwide."
  path="/contact"
  schemas={[contactSchema]}
>
  <section class="section">
    <div class="container">
      <span class="section-label">Get started</span>
      <h1 class="section-heading">Two ways to get started.</h1>

      <div class="contact-cta-grid">
        <BorderBeam alwaysOn={true} dual={true} class="cta-option cta-option-book" tag="div">
          <span class="cta-option-eyebrow">Ready now</span>
          <h2 class="cta-option-title">Book a meeting</h2>
          <p class="cta-option-copy">
            Already know you want to talk? Book a free 30-minute call with the AITS team right
            now — no forms, no waiting.
          </p>
          <a href="https://calendly.com/gavin-aits" class="btn-primary" target="_blank" rel="noopener">Book 30 minutes →</a>
        </BorderBeam>
        <BorderBeam dual={true} class="cta-option cta-option-scan" tag="div">
          <span class="cta-option-eyebrow">90 seconds</span>
          <h2 class="cta-option-title">Take the AI Readiness Scan</h2>
          <p class="cta-option-copy">
            Not ready to book yet? Take the free AI Readiness Scan first — usually 90 seconds,
            never more than 3–4 minutes — so we have even more to work with when we talk.
          </p>
          <a href="/scan.html" class="btn-primary">Start the free scan →</a>
        </BorderBeam>
      </div>

      <p class="section-sub cta-sub-note">
        Prefer to look around first? Answer a few questions on a call and you'll leave with a
        prioritized plan you can act on immediately, whether or not we ever work together.
      </p>

      <div class="contact-grid">
        <a class="card contact-card" href={`tel:${BUSINESS.phone}`}>
          <div class="sicon">📞</div>
          <span class="label">Call</span>
          <span class="value">{BUSINESS.phoneDisplay}</span>
          <ul class="reveal-list">
            <li>Fastest way to reach us</li>
            <li>A person answers — that's kind of our thing</li>
          </ul>
        </a>
        <a class="card contact-card" href={`mailto:${BUSINESS.email}`}>
          <div class="sicon">✉️</div>
          <span class="label">Email</span>
          <span class="value">{BUSINESS.email}</span>
          <ul class="reveal-list">
            <li>Replies same business day</li>
            <li>Straight to the founder — no ticket queue</li>
          </ul>
        </a>
        <div class="card contact-card">
          <div class="sicon teal">📍</div>
          <span class="label">Serving</span>
          <span class="value">{BUSINESS.areasServed.join(' · ')}</span>
          <ul class="reveal-list">
            <li>On-site across Southern California</li>
            <li>Remote-first everywhere else — same team, same response</li>
          </ul>
        </div>
      </div>

      <div class="expect">
        <span class="section-label">What the 30 minutes looks like</span>
        <div class="expect-grid">
          {
            expect.map((s) => (
              <div class="expect-step">
                <div class="step-num">{s.n}</div>
                <h2>{s.h}</h2>
                <p>{s.p}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin-bottom: 48px;
  }
  .contact-card {
    display: block;
    color: inherit;
  }
  .contact-card:hover {
    text-decoration: none;
    color: inherit;
  }
  .sicon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--aglow);
    border: 0.5px solid rgba(59, 110, 240, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    font-size: 20px;
  }
  .sicon.teal {
    background: var(--tdim);
    border-color: rgba(0, 201, 167, 0.25);
  }
  .label {
    display: block;
    font-family: var(--jak);
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--teal2);
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .value {
    font-size: 1.1rem;
    font-weight: 700;
    word-break: break-word;
  }
  .expect {
    margin-bottom: 48px;
  }
  .expect-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
    margin-top: 8px;
  }
  .step-num {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--aglow);
    border: 0.5px solid rgba(59, 110, 240, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--accent2);
    margin-bottom: 14px;
  }
  .expect-step h2 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .expect-step p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
  }
  .contact-cta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 28px;
    margin-bottom: 24px;
  }
  .cta-option {
    padding: 34px 32px;
    background: #0a0d17;
    border: 0.5px solid rgba(59, 110, 240, 0.28);
    border-radius: var(--radius);
  }
  .cta-option-book {
    background: linear-gradient(160deg, rgba(59, 110, 240, 0.16), rgba(0, 201, 167, 0.05));
    border: 1px solid rgba(59, 110, 240, 0.55);
    box-shadow: 0 0 40px rgba(59, 110, 240, 0.14);
  }
  .cta-option-eyebrow {
    display: inline-block;
    font-family: var(--jak);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal2);
    margin-bottom: 12px;
  }
  .cta-option-title {
    font-family: var(--fran);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }
  .cta-option-copy {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 22px;
  }
  .cta-sub-note {
    max-width: 640px;
    margin-bottom: 48px;
  }
  @media (max-width: 720px) {
    .contact-cta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
