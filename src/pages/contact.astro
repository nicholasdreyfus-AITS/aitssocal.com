---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS, FORM_ENDPOINT } from '../consts';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact AITS',
  description: 'Book a free AI assessment with AITS. Most plans start at $250/month.',
};

const expect = [
  { n: '01', h: 'We listen first', p: 'You talk, we map: where time is being lost, what your team hates doing, what growth is stuck behind.' },
  { n: '02', h: 'You get a real plan', p: 'A prioritized list of AI opportunities ranked by ROI — yours to keep whether we work together or not.' },
  { n: '03', h: 'A win in 30 days', p: 'If we do work together, your highest-value automation goes live fast enough for the whole team to feel it.' },
];
---

<BaseLayout
  title="Contact"
  description="Book a free AI assessment with AITS. No pitch, no jargon — a real plan you can act on immediately. Most plans start at $250/month. San Diego HQ, serving businesses nationwide."
  path="/contact"
  schemas={[contactSchema]}
>
  <section class="section">
    <div class="container">
      <span class="section-label">Free assessment</span>
      <h1 class="section-heading">Thirty minutes. <em>No pitch. A real plan.</em></h1>
      <p class="section-sub">
        Book a 30-minute call or send a message below — either way you leave with a prioritized
        plan you can act on immediately, whether or not we ever work together.
      </p>

      <div class="contact-grid">
        <a class="card contact-card" href={`tel:${BUSINESS.phone}`}>
          <div class="sicon">📞</div>
          <span class="label">Call</span>
          <span class="value">{BUSINESS.phoneDisplay}</span>
          <ul class="reveal-list">
            <li>Fastest way to reach us</li>
            <li>A person answers — that's kind of our thing</li>
          </ul>
        </a>
        <a class="card contact-card" href={`mailto:${BUSINESS.email}`}>
          <div class="sicon">✉️</div>
          <span class="label">Email</span>
          <span class="value">{BUSINESS.email}</span>
          <ul class="reveal-list">
            <li>Replies same business day</li>
            <li>Straight to the founder — no ticket queue</li>
          </ul>
        </a>
        <div class="card contact-card">
          <div class="sicon teal">📍</div>
          <span class="label">Serving</span>
          <span class="value">{BUSINESS.areasServed.join(' · ')}</span>
          <ul class="reveal-list">
            <li>On-site across Southern California</li>
            <li>Remote-first everywhere else — same team, same response</li>
          </ul>
        </div>
      </div>

      <div class="expect">
        <span class="section-label">What the 30 minutes looks like</span>
        <div class="expect-grid">
          {
            expect.map((s) => (
              <div class="expect-step">
                <div class="step-num">{s.n}</div>
                <h2>{s.h}</h2>
                <p>{s.p}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="contact-actions">
        <div class="card form-card">
          <span class="section-label">Send a message</span>
          <p class="form-copy">
            Not ready to book a call? Tell us what's going on and we'll reply the same business
            day — straight to the founder, no ticket queue.
          </p>
          <form id="contactForm" novalidate>
            <div class="field">
              <label for="cf-name">Name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="cf-email">Email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="cf-company">Company <span class="opt">(optional)</span></label>
              <input id="cf-company" name="company" type="text" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="cf-message">What can we help with?</label>
              <textarea id="cf-message" name="message" rows="4" required></textarea>
            </div>
            <button type="submit" class="btn-primary" id="cf-submit" data-cta="contact-form">
              Send message
            </button>
            <p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
            <p class="form-note">No spam, ever. A real person replies the same business day.</p>
          </form>
        </div>

        <div class="booking card">
          <span class="section-label">Book your free 30-minute assessment</span>
          <p class="booking-copy">
            Prefer to talk? Pick a time and we'll take it from there. No obligation, no pressure —
            and if we do end up working together, most plans start at <strong>$250 a month</strong>,
            month-to-month, fixes included.
          </p>
          <a
            href="https://calendly.com/gavin-aits"
            class="btn-primary"
            target="_blank"
            rel="noopener"
            data-cta="book-call">Book 30 minutes</a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ endpoint: `${FORM_ENDPOINT}/contact` }}>
  (function () {
    var form = document.getElementById('contactForm');
    if (!form) return;
    var btn = document.getElementById('cf-submit');
    var status = document.getElementById('cf-status');

    function setStatus(msg, kind) {
      status.textContent = msg;
      status.className = 'form-status' + (kind ? ' is-' + kind : '');
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var data = {
        name: form.name.value.trim(),
        email: form.email.value.trim(),
        company: form.company.value.trim(),
        message: form.message.value.trim(),
      };
      if (!data.name || !data.email || !data.message) {
        setStatus('Please add your name, email, and a short message.', 'error');
        return;
      }
      btn.disabled = true;
      var original = btn.textContent;
      btn.textContent = 'Sending…';
      setStatus('', '');
      try {
        var res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        var out = await res.json().catch(function () { return {}; });
        if (res.ok && out.ok) {
          form.reset();
          setStatus("Thanks — your message is on its way. We'll reply the same business day.", 'ok');
          if (window.gtag) gtag('event', 'lead_submit', { method: 'contact_form' });
        } else {
          setStatus(
            (out && out.error) ||
              'Something went wrong. Please email ' +
                'gavin@aits.llc' +
                ' or call (858) 337-2866.',
            'error'
          );
        }
      } catch (err) {
        setStatus(
          'Network error. Please email gavin@aits.llc or call (858) 337-2866.',
          'error'
        );
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  })();
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin-bottom: 48px;
  }
  .contact-card {
    display: block;
    color: inherit;
  }
  .contact-card:hover {
    text-decoration: none;
    color: inherit;
  }
  .sicon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--aglow);
    border: 0.5px solid rgba(59, 110, 240, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    font-size: 20px;
  }
  .sicon.teal {
    background: var(--tdim);
    border-color: rgba(0, 201, 167, 0.25);
  }
  .label {
    display: block;
    font-family: var(--jak);
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--teal2);
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .value {
    font-size: 1.1rem;
    font-weight: 700;
    word-break: break-word;
  }
  .expect {
    margin-bottom: 48px;
  }
  .expect-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
    margin-top: 8px;
  }
  .step-num {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--aglow);
    border: 0.5px solid rgba(59, 110, 240, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--accent2);
    margin-bottom: 14px;
  }
  .expect-step h2 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .expect-step p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
  }
  .booking {
    text-align: center;
    padding: 40px;
    border-color: rgba(0, 201, 167, 0.3);
  }
  .booking-copy {
    color: var(--muted);
    font-size: 15px;
    max-width: 560px;
    margin: 4px auto 22px;
    line-height: 1.7;
  }
  .booking-copy strong {
    color: var(--teal2);
  }

  /* Two-path actions: message form + booking */
  .contact-actions {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 760px) {
    .contact-actions {
      grid-template-columns: 1fr;
    }
  }
  .form-card {
    text-align: left;
  }
  .form-copy {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
    margin: 4px 0 20px;
  }
  .field {
    margin-bottom: 14px;
  }
  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--text2);
    margin-bottom: 6px;
  }
  .field .opt {
    color: var(--muted);
    font-weight: 400;
  }
  .field input,
  .field textarea {
    width: 100%;
    background: rgba(7, 9, 15, 0.6);
    border: 1px solid var(--border2);
    border-radius: 10px;
    padding: 11px 14px;
    color: var(--text);
    font-family: var(--jak);
    font-size: 15px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field textarea {
    resize: vertical;
    min-height: 96px;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--muted);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent2);
    box-shadow: 0 0 0 3px rgba(59, 110, 240, 0.18);
  }
  .form-card .btn-primary {
    width: 100%;
    margin-top: 4px;
  }
  .form-card .btn-primary:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .form-status {
    font-size: 13px;
    line-height: 1.6;
    margin-top: 12px;
    min-height: 1px;
  }
  .form-status.is-ok {
    color: var(--teal2);
  }
  .form-status.is-error {
    color: #ff9b9b;
  }
  .form-note {
    font-size: 12px;
    color: var(--muted);
    margin-top: 10px;
  }
</style>
