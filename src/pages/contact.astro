---
import BaseLayout from '../layouts/BaseLayout.astro';
import BorderBeam from '../components/BorderBeam.astro';
import { BUSINESS } from '../consts';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact AITS',
  description: 'Book a free AI assessment with AITS. Most plans start at $297/month.',
};

const expect = [
  { n: '01', h: 'We listen first', p: 'You talk, we map: where time is being lost, what your team hates doing, what growth is stuck behind.' },
  { n: '02', h: 'You get a real plan', p: 'A prioritized list of AI opportunities ranked by ROI — yours to keep whether we work together or not.' },
  { n: '03', h: 'A win in 30 days', p: 'If we do work together, your highest-value automation goes live fast enough for the whole team to feel it.' },
];
const bookingUrl = 'https://api.leadconnectorhq.com/widget/booking/MmJlaUefrCV2ah3CWyu4';
const proxyUrl = 'https://aits-scan.nicholasdreyfus.workers.dev/contact';
---

<BaseLayout
  title="Contact"
  description="Book a free AI assessment with AITS. No pitch, no jargon — a real plan you can act on immediately. Most plans start at $297/month. San Diego HQ, serving businesses nationwide."
  path="/contact"
  schemas={[contactSchema]}
>
  <section class="section">
    <div class="container">
      <span class="section-label">Get started</span>
      <h1 class="section-heading">Two ways to get started.</h1>

      <div class="contact-cta-grid">
        <BorderBeam alwaysOn={true} dual={true} class="cta-option cta-option-book" tag="div">
          <span class="cta-option-eyebrow">Ready now</span>
          <h2 class="cta-option-title">Book a meeting</h2>
          <p class="cta-option-copy">
            Already know you want to talk? Book a free 30-minute call with the AITS team right
            now — no forms, no waiting.
          </p>
          <a href={bookingUrl} class="btn-primary" target="_blank" rel="noopener">Book 30 minutes →</a>
        </BorderBeam>
        <BorderBeam dual={true} class="cta-option cta-option-scan" tag="div">
          <span class="cta-option-eyebrow">90 seconds</span>
          <h2 class="cta-option-title">Take the AI Readiness Scan</h2>
          <p class="cta-option-copy">
            Not ready to book yet? Take the free AI Readiness Scan first — usually 90 seconds,
            never more than 3–4 minutes — so we have even more to work with when we talk.
          </p>
          <a href="/risk-scan" class="btn-primary">Start the free scan →</a>
        </BorderBeam>
      </div>

      <div class="contact-form-wrap">
        <span class="section-label">Send us a message</span>
        <h2>Tell us what you want to improve.</h2>
        <p>Every submission goes directly to Nick and Gavin. We will reply by email or phone.</p>
        <form id="contactForm" data-endpoint={proxyUrl} novalidate>
          <div class="form-grid">
            <label><span>First name</span><input name="first_name" autocomplete="given-name" required /></label>
            <label><span>Last name</span><input name="last_name" autocomplete="family-name" required /></label>
            <label><span>Company</span><input name="company_name" autocomplete="organization" /></label>
            <label><span>Work email</span><input name="email" type="email" autocomplete="email" required /></label>
            <label><span>Phone</span><input name="phone" type="tel" autocomplete="tel" required /></label>
          </div>
          <label><span>How can we help?</span><textarea name="message" rows="5" required></textarea></label>
          <div class="form-hp" aria-hidden="true"><label>Website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
          <button class="btn-primary" type="submit" id="contactSubmit">Send my message →</button>
          <p id="contactStatus" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

      <p class="section-sub cta-sub-note">
        Prefer to look around first? Answer a few questions on a call and you'll leave with a
        prioritized plan you can act on immediately, whether or not we ever work together.
      </p>

      <div class="contact-grid">
        <a class="card contact-card" href={`tel:${BUSINESS.phone}`}>
          <div class="sicon">📞</div>
          <span class="label">Call or text</span>
          <span class="value">{BUSINESS.phoneDisplay}</span>
          <ul class="reveal-list">
            <li>Text for the fastest response time</li>
            <li>Prefer to talk? A person answers — that's kind of our thing</li>
          </ul>
        </a>
        <a class="card contact-card" href={`mailto:${BUSINESS.email}`}>
          <div class="sicon">✉️</div>
          <span class="label">Email</span>
          <span class="value">{BUSINESS.email}</span>
          <ul class="reveal-list">
            <li>Replies same business day</li>
            <li>Straight to the founder — no ticket queue</li>
          </ul>
        </a>
        <div class="card contact-card">
          <div class="sicon teal">📍</div>
          <span class="label">Serving</span>
          <span class="value">{BUSINESS.areasServed.join(' · ')}</span>
          <ul class="reveal-list">
            <li>On-site across Southern California</li>
            <li>Remote-first everywhere else — same team, same response</li>
          </ul>
        </div>
      </div>

      <div class="expect">
        <span class="section-label">What the 30 minutes looks like</span>
        <div class="expect-grid">
          {
            expect.map((s) => (
              <div class="expect-step">
                <div class="step-num">{s.n}</div>
                <h2>{s.h}</h2>
                <p>{s.p}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const contactForm = document.getElementById('contactForm') as HTMLFormElement | null;
  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = document.getElementById('contactSubmit') as HTMLButtonElement;
    const status = document.getElementById('contactStatus') as HTMLElement;
    const values = new FormData(contactForm);
    if (!contactForm.reportValidity()) return;
    submit.disabled = true; submit.textContent = 'Sending…'; status.textContent = '';
    try {
      const response = await fetch(contactForm.dataset.endpoint || '', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: `${values.get('first_name')} ${values.get('last_name')}`.trim(), company: values.get('company_name'), email: values.get('email'), phone: values.get('phone'), message: values.get('message'), company_website: values.get('company_website'), attribution: (window as any).aitsAttribution || {} }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.ok !== true) throw new Error(result.error || 'We could not send that message.');
      contactForm.reset(); status.className = 'form-status is-ok'; status.textContent = 'Message received. Nick or Gavin will follow up shortly.';
      (window as any).aitsTrack?.('generate_lead', { form_name: 'contact', page_path: location.pathname });
    } catch (error) {
      status.className = 'form-status is-error'; status.textContent = (error instanceof Error ? error.message : 'We could not send that message.') + ' Please call (619) 837-3320.';
    } finally { submit.disabled = false; submit.textContent = 'Send my message →'; }
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin-bottom: 48px;
  }
  .contact-form-wrap { margin: 0 0 56px; padding: 32px; background: #0a0d17; border: 1px solid rgba(59,110,240,.35); border-radius: var(--radius); }
  .contact-form-wrap h2 { margin: 6px 0 8px; }
  .contact-form-wrap > p { color: var(--muted); margin-bottom: 22px; }
  .form-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16px; }
  #contactForm label { display:block; margin-bottom:16px; }
  #contactForm label > span { display:block; color:var(--teal2); font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; margin-bottom:6px; }
  #contactForm input, #contactForm textarea { width:100%; padding:13px 14px; color:var(--text); background:var(--bg); border:1px solid var(--border3); border-radius:10px; font:inherit; }
  #contactForm input:focus, #contactForm textarea:focus { outline:2px solid var(--accent); outline-offset:1px; }
  .form-hp { position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden; }
  .form-status { margin-top:12px; min-height:22px; }
  .form-status.is-ok { color:var(--teal2); }
  .form-status.is-error { color:#ff7a93; }
  .contact-card {
    display: block;
    color: inherit;
  }
  .contact-card:hover {
    text-decoration: none;
    color: inherit;
  }
  .sicon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--aglow);
    border: 0.5px solid rgba(59, 110, 240, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    font-size: 20px;
  }
  .sicon.teal {
    background: var(--tdim);
    border-color: rgba(0, 201, 167, 0.25);
  }
  .label {
    display: block;
    font-family: var(--jak);
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--teal2);
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .value {
    font-size: 1.1rem;
    font-weight: 700;
    word-break: break-word;
  }
  .expect {
    margin-bottom: 48px;
  }
  .expect-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
    margin-top: 8px;
  }
  .step-num {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--aglow);
    border: 0.5px solid rgba(59, 110, 240, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--accent2);
    margin-bottom: 14px;
  }
  .expect-step h2 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .expect-step p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
  }
  .contact-cta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 28px;
    margin-bottom: 24px;
  }
  .cta-option {
    padding: 34px 32px;
    background: #0a0d17;
    border: 0.5px solid rgba(59, 110, 240, 0.28);
    border-radius: var(--radius);
  }
  .cta-option-book {
    background: linear-gradient(160deg, rgba(59, 110, 240, 0.16), rgba(0, 201, 167, 0.05));
    border: 1px solid rgba(59, 110, 240, 0.55);
    box-shadow: 0 0 40px rgba(59, 110, 240, 0.14);
  }
  .cta-option-eyebrow {
    display: inline-block;
    font-family: var(--jak);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal2);
    margin-bottom: 12px;
  }
  .cta-option-title {
    font-family: var(--fran);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }
  .cta-option-copy {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 22px;
  }
  .cta-sub-note {
    max-width: 640px;
    margin-bottom: 48px;
  }
  @media (max-width: 720px) {
    .contact-cta-grid {
      grid-template-columns: 1fr;
    }
    .form-grid { grid-template-columns:1fr; gap:0; }
  }
</style>
