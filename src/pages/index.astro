---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

// Capability groups — the full breadth of what one AITS partnership covers,
// organized by the customer journey. Deliberately describes capabilities,
// never the underlying platform by name.
const capabilityGroups = [
  {
    label: 'Capture every lead',
    icon: '🎯',
    items: [
      { name: 'AI receptionist & website chat', desc: 'Every call and visitor answered 24/7' },
      { name: 'Missed-call text-back', desc: 'A missed call becomes a text, not a lost job' },
      { name: 'Forms, surveys & quizzes', desc: 'Capture inquiries from anywhere' },
      { name: 'Websites, funnels & landing pages', desc: 'Built, hosted, and maintained for you' },
    ],
  },
  {
    label: 'Convert them to customers',
    icon: '📈',
    items: [
      { name: 'CRM & sales pipeline', desc: 'Every lead tracked from first touch to close' },
      { name: 'Email & SMS marketing', desc: 'Campaigns and blasts that run themselves' },
      { name: 'Automated follow-up', desc: 'Nurture sequences so no lead goes cold' },
      { name: 'Online scheduling & reminders', desc: 'Booking without the back-and-forth' },
    ],
  },
  {
    label: 'Get paid & keep them',
    icon: '💳',
    items: [
      { name: 'Estimates, invoices & payments', desc: 'Quote to cash in one place' },
      { name: 'Review & reputation management', desc: 'More 5-star reviews, automatically' },
      { name: 'Social media scheduling', desc: 'A consistent presence with no daily effort' },
      { name: 'Memberships & courses', desc: 'New revenue from what you already know' },
    ],
  },
  {
    label: 'See what is working',
    icon: '🧭',
    items: [
      { name: 'Unified inbox', desc: 'Calls, texts, emails & DMs in one thread' },
      { name: 'Reporting & ROI dashboards', desc: 'What is working, at a glance' },
      { name: 'Call tracking & attribution', desc: 'Know which marketing actually pays off' },
      { name: 'Mobile app', desc: 'Your whole business in your pocket' },
    ],
  },
];

const promises = [
  {
    h: 'We build it and run it',
    p: 'Your fee includes engineering time every single month. We are not a vendor who hands you software and disappears — we are the team operating it alongside you.',
  },
  {
    h: 'We test it regularly',
    p: 'Every automation we deploy is checked on a schedule, and uptime is monitored continuously. You find out something needed attention after we have already handled it.',
  },
  {
    h: 'We jump on issues',
    p: 'When something breaks, you are not opening a ticket into the void. You have a partner who picks up, diagnoses, and fixes — because reliability is what you are paying for.',
  },
];

const faqs = [
  {
    q: 'How much does it cost for a small business to deploy AI?',
    a: 'One flat monthly fee covers the entire platform — CRM, marketing automation, AI receptionist, booking, reviews, funnels, and reporting — plus the engineering time to run it. It starts with a free 30-minute assessment so you see the value before spending, and engagements are month-to-month with no lock-in.',
  },
  {
    q: 'What is included in the one monthly fee?',
    a: 'Everything: the full platform (CRM and pipeline, email and SMS marketing, AI receptionist and chat, appointment booking, review management, missed-call text-back, websites and funnels, reporting), plus a dedicated engineering team that builds your automations, tests them on a regular schedule, monitors uptime, and jumps on issues the moment something breaks. You are not buying tools — you are gaining a partner.',
  },
  {
    q: 'Why is one fee with AITS less expensive than buying the tools myself?',
    a: 'AITS partners directly with enterprise-grade technology providers at a scale no single small business could reach. Those partnerships come with considerable discounts, and we pass them through — which is why one competitive monthly fee covers the entire platform and the engineering time to keep it working, usually for less than the pile of separate subscriptions it replaces.',
  },
  {
    q: 'Who manages the tools after they are set up?',
    a: 'We do — that is the point. Most businesses buy software and become their own unpaid IT department. With AITS, your automations are tested regularly, uptime is monitored, and when anything needs attention our engineers handle it. You run your business; we run the technology.',
  },
  {
    q: 'How long until we see results from AI?',
    a: 'Our model is built around a visible win in the first 30 days. We deploy your highest-value automation first — often something like an AI receptionist, scheduling, or meeting prep — so the whole team feels the benefit fast.',
  },
  {
    q: 'Will AI replace my employees?',
    a: 'No. AI does not replace your people — it replaces their worst tasks. We automate the repetitive grunt work your team hates so your experts can focus on the high-value work they were actually hired to do.',
  },
  {
    q: 'Is it safe to use AI with our business data?',
    a: 'Only if it is deployed correctly. We set up a secure, governed AI environment with clear policy, access controls, and monitoring — so your team gets the productivity gains without leaking client data, financials, or IP into public tools.',
  },
  {
    q: 'Do we need a big IT team or budget to start?',
    a: 'No. AITS is built specifically for small and mid-sized businesses without a dedicated IT department. We handle the strategy, deployment, and team training, and it starts with a free assessment.',
  },
  {
    q: 'What areas does AITS serve?',
    a: 'AITS is headquartered in San Diego and serves businesses across the entire United States. We are local to Southern California when something needs a human on-site, and remote-first everywhere else — most of what we deploy and manage runs the same no matter where your business operates.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Service schema — describes the all-in-one managed platform as a single
// offering for one flat fee. High-value for AEO: it's what answer engines
// lift for "all-in-one platform for small business" / "managed CRM and
// marketing for one fee" style questions.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'All-in-One Managed Business Platform',
  serviceType: 'Managed business technology and AI platform',
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'United States' },
  description:
    'CRM and sales pipeline, email and SMS marketing, automated follow-up, an AI receptionist and website chat, missed-call text-back, online scheduling, estimates and invoicing with payments, review and reputation management, social media scheduling, memberships and courses, websites and funnels, a unified inbox, call tracking, and reporting dashboards — delivered as one managed platform for one flat monthly fee that includes engineering, regular testing, and uptime monitoring.',
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    description: 'One flat monthly fee covering the full platform plus managed support.',
    availability: 'https://schema.org/InStock',
  },
};

const results = [
  {
    icon: '📞',
    tag: 'AI Receptionist',
    hl: true,
    title: 'A local SD business never misses a lead again',
    desc: 'Their AI receptionist answers every call, qualifies the caller, captures key information, and schedules the right next step — 24 hours a day, without a single staff member involved.',
    big: '24/7',
    lbl: 'coverage with zero added headcount',
  },
  {
    icon: '📅',
    tag: 'Appointment automation',
    title: "Scheduling removed from the team's plate entirely",
    desc: 'Scheduling, confirmation, reminders, and pre-meeting information gathering all automated. Staff stopped doing this manually within the first 30 days of deployment.',
    big: '<30',
    lbl: 'days from kickoff to live automation',
  },
  {
    icon: '📱',
    tag: 'Social media',
    title: 'Consistent brand presence without a marketing hire',
    desc: 'Content creation, scheduling, and brand awareness running on autopilot. The business shows up professionally online every week without anyone on staff spending time on it.',
    big: '0hrs',
    lbl: 'of staff time per week on social content',
  },
  {
    icon: '📋',
    tag: 'Meeting prep',
    title: 'Every meeting starts with the right information already gathered',
    desc: 'AI handles pre-meeting intake, collects needed documents and context, and delivers a clean brief before the meeting starts. No more back-and-forth emails chasing information.',
    big: '100%',
    lbl: 'of meetings arrive with full context ready',
  },
];

const steps = [
  { n: '01', h: 'We ask your team what they hate doing', p: 'Not what you want automated — what they want automated. Those become our first targets.' },
  { n: '02', h: 'We deliver a visible win in the first 30 days', p: 'One meaningful automation, live and working, fast enough that the whole team sees the value before skepticism has time to set in.' },
  { n: '03', h: 'We train your team to work with AI, not around it', p: 'Your people learn to use these tools with confidence. They stop feeling like bystanders and start feeling like they have a superpower at work.' },
  { n: '04', h: 'We scale with a team that is now pulling for it', p: 'Phase two goes faster because your team is requesting new automations, not resisting them.' },
];

const services = [
  { icon: '🤖', feat: true, title: 'AI Integration & Deployment', desc: 'We identify, build, and deploy the highest-leverage AI automations for your workflows. Receptionists, scheduling, content, intake, reporting and more — all with measurable outcomes attached.', tags: ['Workflow automation', 'AI receptionist', 'Custom tools'] },
  { icon: '🗺️', title: 'AI Strategy & Roadmap', desc: 'A structured assessment of your operation that identifies your top AI opportunities, estimates ROI for each, and gives you a phased deployment plan. Starts free.', tags: ['Free to start', 'ROI-backed plan'] },
  { icon: '📢', title: 'AI Marketing & Brand Automation', desc: 'Social media content, brand awareness campaigns, and lead nurturing on autopilot. Professional presence without a full-time marketing hire.', tags: ['Social media', 'Content creation', 'Brand awareness'] },
  { icon: '🖥️', teal: true, title: 'Managed IT Infrastructure', desc: 'Computers, servers, networks, and security — the foundation your AI tools run on. Month-to-month, local support when you need a human on-site.', tags: ['Computers', 'Servers', 'Security'] },
];

const process = [
  { n: '01', h: 'Free AI assessment', p: '30 minutes. We map your workflows, understand where time is being lost, and listen to what your team wants off their plate.', badge: 'Free, no obligation' },
  { n: '02', h: 'Opportunity report', p: 'You receive a prioritized list of AI opportunities ranked by ROI, with clear investment and outcome projections for each one.' },
  { n: '03', h: 'First automation live', p: 'We deploy your highest-value automation first, with a goal to have it live and delivering results inside the first 30 days.' },
  { n: '04', h: 'Scale with your team', p: 'With an early win behind us and your team on board, we expand into the next opportunities — faster, because momentum is on your side.' },
];

const team = [
  { img: '/images/gavin.jpg', pos: 'center 28%', role: 'Founder & Principal', roleClass: 'ceo', name: 'Gavin Dreyfus', title: 'Founder & Principal', bio: "Gavin founded AITS with a clear conviction: AI should be accessible to every small business, not just enterprise companies with dedicated IT departments. As Founder and Principal, he leads day-to-day client strategy and operations, deploying AI quickly and practically for SMB owners who need results, not roadmaps." },
  { img: '/images/nick.jpg', pos: 'center 20%', role: 'Co-Founder & Board Member', roleClass: 'board', name: 'Nick Dreyfus', title: 'Co-Founder, Board Member & VP of Business Development, i-NETT', bio: 'Nick brings over twelve years as a systems administrator and a decade of consulting and network architecture experience to the AITS board. As VP of Business Development at i-NETT, he approaches every client relationship from a position of technical authority — educating and strategizing the way an in-house CTO would.', linkedin: 'https://www.linkedin.com/in/nicholas-dreyfus/' },
  { img: '/images/dale.png', pos: 'center 15%', role: 'Board Member', roleClass: 'board', name: 'Dale Stein', title: 'Board Member • CEO, LensLock • CEO, Technology Assurance Group • Partner, i-NETT', bio: 'Dale Stein is one of the most recognized names in managed technology services in North America. As CEO of LensLock and TAG, and Partner at i-NETT, he leads organizations representing over $1 billion in combined annual products and services.', linkedin: 'https://www.linkedin.com/in/steindale/' },
];
---

<BaseLayout
  title="AITS"
  description="Everything your small business runs on — CRM, marketing automation, AI receptionist, booking, reviews, and reporting — in one managed platform for one flat monthly fee. Built, tested, and supported by AITS. San Diego HQ, serving businesses nationwide."
  path="/"
  schemas={[serviceSchema, faqSchema]}
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-badge"><span class="badge-dot"></span>SMB AI &amp; technology partners</div>
    <h1>Every tool your business runs on.<br /><em>One fee. One partner.</em></h1>
    <div class="hero-divider"></div>
    <p class="hero-sub">
      One managed platform for everything a small business needs — CRM, marketing automation, an
      AI receptionist, booking, reviews, and reporting — built, tested, and supported by our team
      for one flat monthly fee. The tools <em>and</em> the people who keep them working.
    </p>
    <p class="hero-name">Headquartered in San Diego • Serving businesses nationwide</p>
    <div class="hero-actions">
      <a href="/contact" class="btn-primary">Get your free AI assessment</a>
      <a href="#results" class="btn-ghost">See real results</a>
    </div>
  </section>

  <!-- PROOF BAR -->
  <div class="proof-bar">
    <div class="container proof-inner">
      <div class="proof-item"><span class="proof-dot"></span>AI receptionists answering live calls for real businesses</div>
      <div class="proof-item"><span class="proof-dot"></span>Automations live in under 30 days</div>
      <div class="proof-item"><span class="proof-dot"></span>One flat monthly fee — platform, engineering, and support</div>
      <div class="proof-item"><span class="proof-dot"></span>No long-term contracts, ever</div>
    </div>
  </div>

  <!-- ONE PLATFORM, ONE FEE -->
  <section class="section" id="platform">
    <div class="container">
      <span class="section-label">The AITS model</span>
      <h2 class="section-heading">One partner replaces your entire stack.<br /><em class="hl-em">One fee. Everything below.</em></h2>
      <p class="section-sub">
        The tools most businesses buy separately — six, eight, ten subscriptions nobody has time to
        connect, learn, or maintain — delivered as one system we build, run, and keep working for
        you. Here is what a single partnership covers:
      </p>
      <div class="cap-groups">
        {
          capabilityGroups.map((g) => (
            <div class="cap-group">
              <div class="cap-group__head">
                <span class="cap-group__icon" aria-hidden="true">{g.icon}</span>
                <h3 class="cap-group__title">{g.label}</h3>
              </div>
              <ul class="cap-list">
                {g.items.map((it) => (
                  <li>
                    <span class="cap-name">{it.name}</span>
                    <span class="cap-desc">{it.desc}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="cap-tagline">
        That is sixteen jobs, one login, one bill, and one team accountable for all of it.
      </p>

      <div class="promise-grid">
        {
          promises.map((p, i) => (
            <div class="promise-card">
              <div class="promise-num">{String(i + 1).padStart(2, '0')}</div>
              <h3>{p.h}</h3>
              <p>{p.p}</p>
            </div>
          ))
        }
      </div>

      <div class="how-note">
        <strong>How is all of this one fee?</strong> AITS partners directly with enterprise-grade
        technology providers — partnerships at a scale no single small business could reach on its
        own. Those relationships come with considerable discounts, and we pass them through. That
        is why one competitive monthly fee covers the entire platform <em>and</em> the engineering
        time to keep everything working: built, tested regularly, monitored, and fixed the moment
        anything needs attention.
      </div>

      <div class="more">
        <a href="/contact" class="btn-primary">Book a free exploratory call</a>
        <p class="more-note">30 minutes, no pitch. We will map which of these would move the needle for your business first — and what it would take to turn it on.</p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- RESULTS -->
  <section class="section" id="results">
    <div class="container">
      <span class="section-label">Real outcomes, real businesses</span>
      <h2 class="section-heading">We do not run pilots. We deliver results.</h2>
      <p class="section-sub">Every engagement starts with an early win your entire team can see and feel.</p>
      <div class="grid-auto">
        {
          results.map((r) => (
            <div class:list={['card', { hl: r.hl }]}>
              <span class="result-icon">{r.icon}</span>
              <span class:list={['rtag', { p: r.hl }]}>{r.tag}</span>
              <div class="result-title">{r.title}</div>
              <p class="result-desc">{r.desc}</p>
              <div class="rstat"><span class="big">{r.big}</span><span class="lbl">{r.lbl}</span></div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- THE HONEST CONVERSATION -->
  <div class="section band">
    <div class="container trust-layout">
      <div>
        <span class="section-label">The honest conversation</span>
        <h2 class="trust-headline">AI does not replace<br /><em>your people.</em><br />It replaces their worst tasks.</h2>
        <p class="trust-body">
          The number one reason AI deployments fail at small businesses has nothing to do with the
          technology. It is that the team never bought in. Employees hear "AI" and quietly worry
          about their jobs. That resistance kills adoption before it starts.
        </p>
        <p class="trust-body">
          Our entire deployment model is built around this reality. We start with the tasks your
          team hates most, automate those first, and make sure every person sees the benefit to them
          personally before we touch anything else.
        </p>
        <blockquote class="trust-quote">
          "The first thing we automated was appointment scheduling. Within two weeks, three
          employees told me it was the best thing that had happened at work in years. That momentum
          changed everything."
          <cite>— Business owner, San Diego (identity withheld at client request)</cite>
        </blockquote>
      </div>
      <div>
        <span class="section-label">How we bring your team along</span>
        <div class="trust-steps">
          {
            steps.map((s) => (
              <div class="trust-step">
                <div class="ts-num">{s.n}</div>
                <div><h4>{s.h}</h4><p>{s.p}</p></div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <hr class="divider" />

  <!-- SERVICES -->
  <section class="section" id="services">
    <div class="container">
      <span class="section-label">What we deploy</span>
      <h2 class="section-heading">AI-first. Infrastructure underneath it.</h2>
      <p class="section-sub">We lead with the outcomes your business needs and make sure the technology foundation supports them reliably.</p>
      <div class="grid-auto">
        {
          services.map((s) => (
            <div class:list={['card', 'service-card', { feat: s.feat }]}>
              {s.feat && <span class="feat-badge">Core</span>}
              <div class:list={['sicon', { teal: s.teal }]}>{s.icon}</div>
              <div class="service-title">{s.title}</div>
              <p class="result-desc">{s.desc}</p>
              <div>{s.tags.map((t) => <span class:list={['tag', { t: s.teal }]}>{t}</span>)}</div>
            </div>
          ))
        }
      </div>
      <div class="more"><a href="/services" class="btn-ghost">Explore all services</a></div>
    </div>
  </section>

  <hr class="divider" />

  <!-- PROCESS -->
  <section class="section">
    <div class="container">
      <span class="section-label">The process</span>
      <h2 class="section-heading">From assessment to live automation in weeks, not months</h2>
      <p class="section-sub">Built to move at the speed of a real business, with a first win your team sees before you have spent significant time or budget.</p>
      <div class="how-grid">
        {
          process.map((s) => (
            <div class="how-step">
              <div class="step-num">{s.n}</div>
              <div class="step-title">{s.h}</div>
              <p class="step-desc">{s.p}</p>
              {s.badge && <span class="step-badge">{s.badge}</span>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- TEAM -->
  <section class="section" id="team">
    <div class="container">
      <div class="team-intro">
        <span class="section-label">The people behind AITS</span>
        <h2 class="section-heading">Built by a next-generation founder. Backed by decades of real-world results.</h2>
        <p class="section-sub">
          Gavin Dreyfus launched AITS with the vision and energy of a builder who grew up inside the
          technology industry. Behind him stands a board with over 80 combined years of managed
          services, AI deployment, and business leadership across North America.
        </p>
      </div>
      <div class="team-grid">
        {
          team.map((m) => (
            <div class:list={['team-card', { ceo: m.roleClass === 'ceo' }]}>
              <div class="team-photo-wrap">
                <img src={m.img} alt={`${m.name}, ${m.role}`} style={`object-position:${m.pos}`} loading="lazy" />
                <div class="team-photo-overlay" />
              </div>
              <div class="team-info">
                <span class:list={['team-role-badge', `role-${m.roleClass}`]}>{m.role}</span>
                <div class="team-name">{m.name}</div>
                <div class="team-title">{m.title}</div>
                <p class="team-bio">{m.bio}</p>
                {m.linkedin && (
                  <a href={m.linkedin} target="_blank" rel="noopener" class="team-linkedin">Connect on LinkedIn →</a>
                )}
              </div>
            </div>
          ))
        }
      </div>
      <div class="board-note">
        <strong>A note on Gavin's backing:</strong> Nick Dreyfus and Dale Stein are not passive
        advisors — they are active operators with decades of proven results serving the same market
        AITS is built to serve. When you work with Gavin, you are working with a team whose combined
        expertise spans managed services, AI deployment, cybersecurity, national technology
        partnerships, and over 40 years of SMB business leadership.
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container">
      <span class="section-label">Common questions</span>
      <h2 class="section-heading">AI for your business, answered plainly</h2>
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-glow"></div>
    <span class="section-label" style="text-align:center">Free AI assessment</span>
    <h2 class="cta-h2">One platform. One fee.<br /><em>One partner who runs it.</em></h2>
    <div class="hero-divider" style="margin-inline:auto"></div>
    <p class="cta-sub">
      Stop paying for six disconnected tools nobody owns. Get everything your business runs on in
      one managed platform — and a team that builds it, tests it, and jumps on issues. Start with a
      free 30-minute assessment.
    </p>
    <div class="hero-actions" style="justify-content:center">
      <a href="/contact" class="btn-primary">Get your free AI assessment</a>
      <a href="#results" class="btn-ghost">See real results first</a>
    </div>
    <p class="cta-fine">No pitch. No jargon. A real plan you can act on immediately.</p>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 140px 5vw 90px;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(59, 110, 240, 0.12);
    border: 0.5px solid rgba(59, 110, 240, 0.32);
    border-radius: 100px;
    padding: 7px 16px;
    font-size: 12px;
    color: var(--accent3);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--teal);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--teal);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.4); }
  }
  .hero h1 {
    font-family: var(--fran);
    font-size: clamp(38px, 5.5vw, 68px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.01em;
    max-width: 860px;
    margin-bottom: 10px;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--accent2);
  }
  .hero-divider {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--teal));
    border-radius: 2px;
    margin: 20px 0 26px;
  }
  .hero-sub {
    font-size: clamp(16px, 1.8vw, 20px);
    color: var(--text2);
    max-width: 620px;
    margin-bottom: 14px;
  }
  .hero-name {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
