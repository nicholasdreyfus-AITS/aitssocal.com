---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BorderBeam from '../../components/BorderBeam.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Card thumbnail: editorial hero if the post has one, else the episode's
// YouTube thumbnail, else no image (text-only card).
const thumb = (data: (typeof posts)[number]['data']) =>
  data.heroImage ?? (data.youtube ? `https://i.ytimg.com/vi/${data.youtube}/hqdefault.jpg` : null);

const [featured, ...rest] = posts;
---

<BaseLayout
  title="Blog"
  description="Practical guidance on AI deployment, shadow AI risk, compliance, and technology modernization for small and mid-sized businesses."
  path="/blog"
>
  <section class="section">
    <div class="container">
      <span class="section-label">AITS Insights</span>
      <h1 class="section-heading">AI, modernized — <em>written for the people who run the business.</em></h1>
      <p class="section-sub">
        No jargon. Just clear, practical guidance on deploying AI, managing risk, and modernizing
        your technology — most of it straight from The Digital Dilemma podcast.
      </p>

      {posts.length === 0 && <p class="muted">First posts are on the way.</p>}

      {
        featured && (
          <BorderBeam dual={true} tag="a" href={`/blog/${featured.id}`} class="card post-card featured">
            {thumb(featured.data) && (
              <div class="thumb">
                <img src={thumb(featured.data)} alt={featured.data.title} width="1280" height="720" loading="eager" />
              </div>
            )}
            <div class="body">
              <span class="feat-tag">Latest</span>
              <time datetime={featured.data.pubDate.toISOString()}>{fmt(featured.data.pubDate)}</time>
              <h2>{featured.data.title}</h2>
              <p>{featured.data.description}</p>
              <div class="tags">
                {featured.data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
          </BorderBeam>
        )
      }

      <div class="post-grid">
        {
          rest.map((post) => (
            <BorderBeam dual={true} tag="a" href={`/blog/${post.id}`} class="card post-card">
              {thumb(post.data) ? (
                <div class="thumb">
                  <img src={thumb(post.data)} alt={post.data.title} width="640" height="360" loading="lazy" />
                </div>
              ) : (
                <div class="thumb thumb-empty" aria-hidden="true">
                  <span>AITS</span>
                </div>
              )}
              <div class="body">
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <div class="tags">
                  {post.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              </div>
            </BorderBeam>
          ))
        }
      </div>

      <NewsletterSignup />
    </div>
  </section>
</BaseLayout>

<style>
  .post-card {
    display: block;
    color: inherit;
    padding: 0;
    overflow: hidden;
  }
  .post-card:hover {
    text-decoration: none;
    color: inherit;
  }
  .thumb {
    aspect-ratio: 16 / 8;
    overflow: hidden;
    border-bottom: 0.5px solid var(--border2);
    background: var(--bg3);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .post-card:hover .thumb img {
    transform: scale(1.04);
  }
  .thumb-empty {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .thumb-empty span {
    font-family: var(--fran);
    font-size: 28px;
    font-weight: 600;
    color: var(--border3);
    letter-spacing: 0.2em;
  }
  .body {
    padding: 22px 24px 24px;
  }
  .post-card time {
    font-family: var(--jak);
    font-size: 12px;
    color: var(--muted);
  }
  .post-card h2 {
    font-family: var(--fran);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 8px 0;
  }
  .post-card p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.65;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .featured {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    margin-bottom: 20px;
    border-color: rgba(59, 110, 240, 0.35);
  }
  .featured .thumb {
    aspect-ratio: auto;
    height: 100%;
    min-height: 260px;
    border-bottom: none;
    border-right: 0.5px solid var(--border2);
  }
  .featured .body {
    padding: 30px 32px;
    align-self: center;
  }
  .featured h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
  }
  .feat-tag {
    display: inline-block;
    background: var(--aglow);
    border: 0.5px solid rgba(59, 110, 240, 0.3);
    color: var(--accent3);
    font-size: 10px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 100px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin-bottom: 12px;
    margin-right: 10px;
  }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
  }
  .muted {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .featured .thumb {
      min-height: 0;
      aspect-ratio: 16 / 8;
      border-right: none;
      border-bottom: 0.5px solid var(--border2);
    }
  }
</style>
