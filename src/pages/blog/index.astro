---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Blog"
  description="Practical guidance on AI deployment, shadow AI risk, compliance, and technology modernization for small and mid-sized businesses."
  path="/blog"
>
  <section class="section">
    <div class="container">
      <p class="section-label">AITS Insights</p>
      <h1>AI, modernized — written for the people who run the business.</h1>
      <p class="lede prose">
        No jargon. Just clear, practical guidance on deploying AI, managing risk, and modernizing
        your technology — built for small and mid-sized businesses.
      </p>

      {posts.length === 0 && <p class="muted">First posts are on the way.</p>}

      <ul class="post-list">
        {
          posts.map((post) => (
            <li class="post-card">
              <a href={`/blog/${post.id}`}>
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="tags">
                    {post.data.tags.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    color: var(--muted);
    font-size: 1.15rem;
    margin: 16px 0 40px;
  }
  .post-list {
    list-style: none;
    display: grid;
    gap: 20px;
  }
  .post-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .post-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .post-card a {
    display: block;
    padding: 24px;
    color: inherit;
  }
  .post-card a:hover {
    text-decoration: none;
  }
  .post-card time {
    font-family: var(--jak);
    font-size: 12px;
    color: var(--muted);
  }
  .post-card h2 {
    font-size: 1.35rem;
    margin: 8px 0;
  }
  .post-card p {
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .muted {
    color: var(--muted);
  }
</style>
