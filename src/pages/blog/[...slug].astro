---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { SITE, BUSINESS } from '../../consts';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
const url = new URL(`/blog/${post.id}`, SITE.url).href;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Article schema — tells search + answer engines this is authored, dated content.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': data.author === SITE.name ? 'Organization' : 'Person', name: data.author },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: url,
  ...(data.image ? { image: new URL(data.image, SITE.url).href } : {}),
};

// FAQPage schema — high-value for AEO; lets engines lift direct Q&A answers.
const faqSchema =
  data.faq && data.faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
    { '@type': 'ListItem', position: 3, name: data.title, item: url },
  ],
};

// VideoObject — when the post is based on a Digital Dilemma episode, this
// makes the video eligible for video-rich results and gives answer engines
// the episode to cite alongside the article.
const videoSchema = data.youtube
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: data.title,
      description: data.description,
      thumbnailUrl: `https://i.ytimg.com/vi/${data.youtube}/hqdefault.jpg`,
      uploadDate: data.pubDate.toISOString(),
      contentUrl: `https://www.youtube.com/watch?v=${data.youtube}`,
      embedUrl: `https://www.youtube.com/embed/${data.youtube}`,
    }
  : null;

const schemas = [
  articleSchema,
  breadcrumbSchema,
  ...(faqSchema ? [faqSchema] : []),
  ...(videoSchema ? [videoSchema] : []),
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  path={`/blog/${post.id}`}
  ogType="article"
  image={data.image ?? SITE.defaultOgImage}
  schemas={schemas}
>
  <article class="section">
    <div class="container prose">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/blog">Blog</a>
      </nav>

      <header class="post-head">
        {data.tags.length > 0 && (
          <div class="tags">{data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        )}
        <h1>{data.title}</h1>
        <p class="byline">
          <time datetime={data.pubDate.toISOString()}>{fmt(data.pubDate)}</time>
          <span aria-hidden="true">·</span> {data.author}
          {data.updatedDate && <span class="updated"> · Updated {fmt(data.updatedDate)}</span>}
        </p>
      </header>

      {data.youtube && (
        <a
          class="watch"
          href={`https://www.youtube.com/watch?v=${data.youtube}`}
          target="_blank"
          rel="noopener"
          aria-label="Watch this episode of The Digital Dilemma on YouTube"
        >
          <img
            class="watch-thumb"
            src={`https://i.ytimg.com/vi/${data.youtube}/hqdefault.jpg`}
            alt=""
            width="480"
            height="360"
            loading="lazy"
          />
          <span class="watch-body">
            <span class="watch-play" aria-hidden="true">▶</span>
            <span class="watch-text">
              <span class="watch-eyebrow">The Digital Dilemma · Podcast</span>
              <span class="watch-label">Watch this episode on YouTube</span>
            </span>
          </span>
        </a>
      )}

      <div class="content">
        <Content />
      </div>

      {
        data.faq && data.faq.length > 0 && (
          <section class="faq" aria-labelledby="faq-h">
            <h2 id="faq-h">Frequently asked questions</h2>
            {data.faq.map((f) => (
              <details>
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </section>
        )
      }

      <aside class="cta-block">
        <p class="section-label">Next step</p>
        <h2>See what AI should be doing in your business.</h2>
        <p>
          Get a free assessment from AITS. No pitch, no jargon — a real plan you can act on
          immediately.
        </p>
        <a href="/contact" class="btn-primary">Get your free AI assessment</a>
        <p class="partner">
          AITS focuses on AI, cybersecurity, and IT for smaller and growing organizations —
          and works in close partnership with i-NETT, which specializes in organizations with
          20+ full-time employees. Whatever your size, you're covered.
        </p>
        <p class="muted">{BUSINESS.areasServed.join(' · ')}</p>
      </aside>

      <NewsletterSignup />
    </div>
  </article>
</BaseLayout>

<style>
  .crumbs {
    font-family: var(--jak);
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .crumbs a {
    color: var(--muted);
  }
  .post-head {
    margin-bottom: 32px;
  }
  .tags {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    margin-bottom: 14px;
  }
  .byline {
    font-family: var(--jak);
    font-size: 13px;
    color: var(--muted);
  }
  .updated {
    color: var(--accent);
  }
  .watch {
    display: block;
    position: relative;
    margin: 8px 0 32px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg2);
    aspect-ratio: 16 / 8;
    text-decoration: none;
  }
  .watch:hover {
    border-color: var(--accent);
  }
  .watch-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  .watch:hover .watch-thumb {
    opacity: 0.65;
  }
  .watch-body {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 clamp(18px, 4vw, 32px);
    background: linear-gradient(90deg, rgba(7, 9, 15, 0.82), rgba(7, 9, 15, 0.5));
  }
  .watch-play {
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #ff0000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    padding-left: 4px;
  }
  .watch-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .watch-eyebrow {
    font-family: var(--jak);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent2, #6b9bff);
    font-weight: 600;
  }
  .watch-label {
    font-family: var(--fran);
    font-size: clamp(16px, 2.4vw, 21px);
    font-weight: 600;
    color: #fff;
    line-height: 1.25;
  }
  .faq {
    margin-top: 56px;
    border-top: 1px solid var(--border);
    padding-top: 32px;
  }
  .faq h2 {
    margin-bottom: 16px;
  }
  .faq details {
    border-bottom: 1px solid var(--border);
    padding: 14px 0;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--text);
  }
  .faq p {
    color: var(--muted);
    margin-top: 10px;
  }
  .cta-block {
    margin-top: 56px;
    background: linear-gradient(135deg, var(--bg2), transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
  }
  .cta-block h2 {
    font-size: 1.5rem;
    margin: 6px 0 12px;
  }
  .cta-block p {
    color: var(--muted);
    margin-bottom: 18px;
  }
  .cta-block .partner {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .cta-block .muted {
    color: var(--muted);
    font-size: 13px;
    margin: 14px 0 0;
  }
</style>
