---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { SITE, BUSINESS } from '../../consts';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
const url = new URL(`/blog/${post.id}`, SITE.url).href;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Everywhere The Digital Dilemma can be followed — shown on every post so
// readers can subscribe on whatever platform they already use.
const PODCAST_LINKS = [
  { name: 'Apple Podcasts', icon: '🎙️', href: 'https://podcasts.apple.com/us/podcast/the-digital-dilemma/id1764658911' },
  { name: 'Spotify', icon: '🎧', href: 'https://open.spotify.com/show/32P8yEm061V5PRhZBVgrPM' },
  { name: 'YouTube', icon: '▶️', href: 'https://www.youtube.com/channel/UCWcdscFXqBjRG838BAFGsUw?sub_confirmation=1' },
  { name: 'Amazon Music', icon: '🎵', href: 'https://music.amazon.com/podcasts/1cc117d6-5e20-41d6-986b-15a506c4169d/the-digital-dilemma' },
  { name: 'iHeartRadio', icon: '❤️', href: 'https://www.iheart.com/podcast/269-the-digital-dilemma-321536976/' },
  { name: 'Deezer', icon: '🎶', href: 'https://www.deezer.com/show/1001203851' },
];

// Article schema — tells search + answer engines this is authored, dated content.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': data.author === SITE.name ? 'Organization' : 'Person', name: data.author },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: url,
  ...(data.image ? { image: new URL(data.image, SITE.url).href } : {}),
};

// FAQPage schema — high-value for AEO; lets engines lift direct Q&A answers.
const faqSchema =
  data.faq && data.faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
    { '@type': 'ListItem', position: 3, name: data.title, item: url },
  ],
};

// VideoObject — when the post is based on a Digital Dilemma episode, this
// makes the video eligible for video-rich results and gives answer engines
// the episode to cite alongside the article.
const videoSchema = data.youtube
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: data.title,
      description: data.description,
      thumbnailUrl: `https://i.ytimg.com/vi/${data.youtube}/hqdefault.jpg`,
      uploadDate: data.pubDate.toISOString(),
      contentUrl: `https://www.youtube.com/watch?v=${data.youtube}`,
      embedUrl: `https://www.youtube.com/embed/${data.youtube}`,
    }
  : null;

// PodcastSeries — ties every post to The Digital Dilemma so search and
// answer engines associate the articles with the show (and can surface
// subscribe links).
const podcastSchema = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: 'The Digital Dilemma',
  url: 'https://podcasts.apple.com/us/podcast/the-digital-dilemma/id1764658911',
  webFeed: 'https://api.riverside.fm/hosting/QL16ouQn.rss',
  author: { '@type': 'Person', name: 'Nick Dreyfus' },
  sameAs: [
    'https://open.spotify.com/show/32P8yEm061V5PRhZBVgrPM',
    'https://www.youtube.com/channel/UCWcdscFXqBjRG838BAFGsUw',
    'https://music.amazon.com/podcasts/1cc117d6-5e20-41d6-986b-15a506c4169d/the-digital-dilemma',
    'https://www.iheart.com/podcast/269-the-digital-dilemma-321536976/',
  ],
};

const schemas = [
  articleSchema,
  breadcrumbSchema,
  podcastSchema,
  ...(faqSchema ? [faqSchema] : []),
  ...(videoSchema ? [videoSchema] : []),
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  path={`/blog/${post.id}`}
  ogType="article"
  image={data.image ?? SITE.defaultOgImage}
  schemas={schemas}
>
  <article class="section">
    <div class="container prose">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/blog">Blog</a>
      </nav>

      <header class="post-head">
        {data.tags.length > 0 && (
          <div class="tags">{data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        )}
        <h1>{data.title}</h1>
        <p class="byline">
          <time datetime={data.pubDate.toISOString()}>{fmt(data.pubDate)}</time>
          <span aria-hidden="true">·</span> {data.author}
          {data.updatedDate && <span class="updated"> · Updated {fmt(data.updatedDate)}</span>}
        </p>
      </header>

      {data.heroImage ? (
        <figure class="post-hero">
          <img
            src={data.heroImage}
            alt={data.heroAlt ?? ''}
            width="1280"
            height="720"
            loading="eager"
          />
        </figure>
      ) : data.youtube ? (
        <a
          class="watch"
          href={`https://www.youtube.com/watch?v=${data.youtube}`}
          target="_blank"
          rel="noopener"
          aria-label="Watch this episode of The Digital Dilemma on YouTube"
        >
          <img
            class="watch-thumb"
            src={`https://i.ytimg.com/vi/${data.youtube}/hqdefault.jpg`}
            alt=""
            width="480"
            height="360"
            loading="lazy"
          />
          <span class="watch-body">
            <span class="watch-play" aria-hidden="true">▶</span>
            <span class="watch-text">
              <span class="watch-eyebrow">The Digital Dilemma · Podcast</span>
              <span class="watch-label">Watch this episode on YouTube</span>
            </span>
          </span>
        </a>
      ) : null}

      <div class="content">
        <Content />
      </div>

      {
        data.faq && data.faq.length > 0 && (
          <section class="faq" aria-labelledby="faq-h">
            <h2 id="faq-h">Frequently asked questions</h2>
            {data.faq.map((f) => (
              <details>
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </section>
        )
      }

      <aside class="cta-block">
        <p class="section-label">Next step</p>
        <h2>See what AI should be doing in your business.</h2>
        <p>
          Get a free assessment from AITS. No pitch, no jargon — a real plan you can act on
          immediately.
        </p>
        <a href="/contact" class="btn-primary">Get your free AI assessment</a>
        <p class="partner">
          AITS focuses on AI, cybersecurity, and IT for smaller and growing organizations —
          and works in close partnership with i-NETT, which specializes in organizations with
          20+ full-time employees. Whatever your size, you're covered.
        </p>
        <p class="muted">{BUSINESS.areasServed.join(' · ')}</p>
      </aside>

      {data.youtube && (
        <section class="episode-embed" aria-labelledby="ep-h">
          <p class="section-label">Watch the episode</p>
          <h2 id="ep-h">The Digital Dilemma</h2>
          <p class="episode-sub">Prefer to watch or listen? Play the full episode this article is based on.</p>
          <div class="embed-frame">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${data.youtube}`}
              title={`The Digital Dilemma — ${data.title}`}
              loading="lazy"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <a
            class="embed-yt-link"
            href={`https://www.youtube.com/watch?v=${data.youtube}`}
            target="_blank"
            rel="noopener"
          >Watch on YouTube ↗</a>
        </section>
      )}

      <section class="subscribe" aria-labelledby="sub-h">
        <p class="section-label">Never miss an episode</p>
        <h2 id="sub-h">Subscribe to The Digital Dilemma</h2>
        <p class="sub-copy">
          Straight talk on AI, cybersecurity, and business technology — no hype, no vendor
          propaganda. Follow on whatever platform you already use:
        </p>
        <div class="sub-btns">
          {
            PODCAST_LINKS.map((l) => (
              <a class="sub-btn" href={l.href} target="_blank" rel="noopener">
                <span aria-hidden="true">{l.icon}</span> {l.name}
              </a>
            ))
          }
        </div>
      </section>

      <NewsletterSignup />
    </div>
  </article>
</BaseLayout>

<style>
  .crumbs {
    font-family: var(--jak);
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .crumbs a {
    color: var(--muted);
  }
  .post-head {
    margin-bottom: 32px;
  }
  .tags {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    margin-bottom: 14px;
  }
  .byline {
    font-family: var(--jak);
    font-size: 13px;
    color: var(--muted);
  }
  .updated {
    color: var(--accent);
  }
  .watch {
    display: block;
    position: relative;
    margin: 8px 0 32px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg2);
    aspect-ratio: 16 / 8;
    text-decoration: none;
  }
  .watch:hover {
    border-color: var(--accent);
  }
  .watch-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  .watch:hover .watch-thumb {
    opacity: 0.65;
  }
  .watch-body {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 clamp(18px, 4vw, 32px);
    background: linear-gradient(90deg, rgba(7, 9, 15, 0.82), rgba(7, 9, 15, 0.5));
  }
  .watch-play {
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #ff0000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    padding-left: 4px;
  }
  .watch-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .watch-eyebrow {
    font-family: var(--jak);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent2, #6b9bff);
    font-weight: 600;
  }
  .watch-label {
    font-family: var(--fran);
    font-size: clamp(16px, 2.4vw, 21px);
    font-weight: 600;
    color: #fff;
    line-height: 1.25;
  }
  .post-hero {
    margin: 8px 0 32px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .post-hero img {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Editorial images the article text flows around. Placed as
     <figure class="post-fig left|right"> directly in the post markdown. */
  .content :global(.post-fig) {
    margin: 6px 0 22px;
    max-width: 46%;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg2);
  }
  .content :global(.post-fig img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .content :global(.post-fig figcaption) {
    font-family: var(--jak);
    font-size: 12px;
    color: var(--muted);
    padding: 9px 13px;
    line-height: 1.4;
  }
  .content :global(.post-fig.right) {
    float: right;
    margin-left: 30px;
  }
  .content :global(.post-fig.left) {
    float: left;
    margin-right: 30px;
  }
  /* Contain the floats so they don't spill into the FAQ / CTA. */
  .content::after {
    content: '';
    display: block;
    clear: both;
  }
  @media (max-width: 640px) {
    .content :global(.post-fig),
    .content :global(.post-fig.left),
    .content :global(.post-fig.right) {
      float: none;
      max-width: 100%;
      margin: 22px 0;
    }
  }
  .episode-embed {
    margin-top: 56px;
    border-top: 1px solid var(--border);
    padding-top: 32px;
  }
  .episode-embed h2 {
    font-size: 1.35rem;
    margin: 6px 0 6px;
  }
  .episode-sub {
    color: var(--muted);
    margin-bottom: 18px;
  }
  .embed-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #000;
  }
  .embed-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .embed-yt-link {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--jak);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent2);
  }
  .subscribe {
    margin-top: 56px;
    border-top: 1px solid var(--border);
    padding-top: 32px;
  }
  .subscribe h2 {
    font-size: 1.35rem;
    margin: 6px 0 6px;
  }
  .sub-copy {
    color: var(--muted);
    margin-bottom: 18px;
    max-width: 560px;
  }
  .sub-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .sub-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 100px;
    border: 1px solid var(--border);
    background: var(--bg2);
    font-family: var(--jak);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .sub-btn:hover {
    border-color: var(--accent);
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 18px rgba(59, 110, 240, 0.15);
    text-decoration: none;
    color: #fff;
  }
  .faq {
    margin-top: 56px;
    border-top: 1px solid var(--border);
    padding-top: 32px;
  }
  .faq h2 {
    margin-bottom: 16px;
  }
  .faq details {
    border-bottom: 1px solid var(--border);
    padding: 14px 0;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--text);
  }
  .faq p {
    color: var(--muted);
    margin-top: 10px;
  }
  .cta-block {
    margin-top: 56px;
    background: linear-gradient(135deg, var(--bg2), transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
  }
  .cta-block h2 {
    font-size: 1.5rem;
    margin: 6px 0 12px;
  }
  .cta-block p {
    color: var(--muted);
    margin-bottom: 18px;
  }
  .cta-block .partner {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .cta-block .muted {
    color: var(--muted);
    font-size: 13px;
    margin: 14px 0 0;
  }
</style>
