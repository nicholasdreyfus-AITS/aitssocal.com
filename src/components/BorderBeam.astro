---
// Reusable "traveling border beam" highlight for a card group.
//
// A short bright segment travels around the card's perimeter, following its
// exact outline (including rounded corners) at a constant speed. Built with
// an SVG <rect pathLength="100"> whose stroke-dasharray/dashoffset are set
// as native SVG attributes (not CSS properties) and animated with SMIL
// <animate>, not CSS @keyframes.
//
// Why: stroke-dasharray/stroke-dashoffset are typed as <length-percentage>
// when parsed as CSS properties, so a bare unitless number like "12" --
// which is exactly what pathLength="100" calls for -- gets rejected as
// invalid and silently falls back (dasharray -> none, i.e. a solid ring
// instead of a segment). Routing calc() around it doesn't help either: some
// engines coerce the bare number to px to make it a valid <length>, which
// then reads as 12 *real screen pixels* instead of 12 pathLength-normalized
// units -- the dash repeats every ~100px around the perimeter instead of
// once. SVG presentation attributes and SMIL use SVG's own numeric grammar
// throughout, so bare pathLength-relative numbers just work as intended.
//
// Supports a second, offset beam (`dual`) for a richer two-comet chase, and
// an `alwaysOn` mode for a permanently-featured card that should never defer
// to the group's hover/focus state.
//
// Usage: wrap a card's contents in <BorderBeam>, put the card's own visual
// classes (background, padding, border, existing hover lift, etc.) on this
// component via `class`. Within a group, `active` marks whichever card
// starts highlighted by default -- see the group's own <script> (e.g. the
// stages section) for the hover/focus transfer logic that moves
// `data-beam-active` between siblings. `alwaysOn` cards ignore that entirely.
// A slotted `badge` renders as a direct child of the card (not nested inside
// the content wrapper), so it can position against the card's own edge.
export interface Props {
  /** Whether this card shows the beam by default (before any hover/focus). */
  active?: boolean;
  /** Permanently on regardless of hover/focus anywhere else in the group. */
  alwaysOn?: boolean;
  /** Must match the card's own border-radius so the beam traces it exactly. */
  radius?: string;
  /** Full loop duration in seconds -- keep within ~4-7 per the design spec. */
  duration?: number;
  /** Beam length as % of perimeter -- keep within ~8-15. */
  segment?: number;
  /** Primary beam color; defaults to the site's accent blue. */
  color?: string;
  /** Render a second beam chasing the first, offset by half the loop. */
  dual?: boolean;
  /** Second beam color; defaults to the site's teal accent. */
  color2?: string;
  class?: string;
  [attr: string]: unknown;
}

const {
  active = false,
  alwaysOn = false,
  radius = '16px',
  duration = 5.5,
  segment = 12,
  color = 'var(--accent2)',
  dual = false,
  color2 = 'var(--teal2)',
  class: className,
  ...rest
} = Astro.props;

// Second beam lands opposite the first (half the loop later) so the two
// comets stay evenly spaced as they chase each other, matching the
// reference two-beam pattern.
const durationAttr = `${duration}s`;
const delayAttr = `${duration / 2}s`;
const dasharray = `${segment} ${100 - segment}`;
---

<div
  class:list={['beam-card', className]}
  data-beam-active={active ? 'true' : 'false'}
  data-beam-always-on={alwaysOn ? 'true' : 'false'}
  style={`--beam-radius:${radius};--beam-color:${color};--beam-color2:${color2}`}
  {...rest}
>
  <svg class="beam-svg" aria-hidden="true" focusable="false">
    <rect class="beam-track beam-track-1" pathLength="100" stroke-dasharray={dasharray} stroke-dashoffset="0">
      <animate
        attributeName="stroke-dashoffset"
        from="0"
        to="-100"
        dur={durationAttr}
        begin="0s"
        repeatCount="indefinite"
        calcMode="linear"
      ></animate>
    </rect>
    {
      dual && (
        <rect class="beam-track beam-track-2" pathLength="100" stroke-dasharray={dasharray} stroke-dashoffset="0">
          <animate
            attributeName="stroke-dashoffset"
            from="0"
            to="-100"
            dur={durationAttr}
            begin={delayAttr}
            repeatCount="indefinite"
            calcMode="linear"
          ></animate>
        </rect>
      )
    }
  </svg>
  <!-- Direct child of .beam-card (not .beam-content) so slotted badges/
       overlays position against the card's own edge, not the content's
       padding box. -->
  <slot name="badge" />
  <div class="beam-content">
    <slot />
  </div>
</div>

<style>
  .beam-card {
    position: relative;
    isolation: isolate;
  }
  /* Overlay sits above the card's own static border, below the content --
     content is rendered in its own stacking layer via .beam-content. */
  .beam-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .beam-track {
    x: 1px;
    y: 1px;
    width: calc(100% - 2px);
    height: calc(100% - 2px);
    rx: var(--beam-radius);
    fill: none;
    stroke: var(--beam-color);
    stroke-width: 2.5px;
    stroke-linecap: round;
    filter: drop-shadow(0 0 4px var(--beam-color)) drop-shadow(0 0 2px var(--beam-color));
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .beam-track-2 {
    stroke: var(--beam-color2);
    filter: drop-shadow(0 0 4px var(--beam-color2)) drop-shadow(0 0 2px var(--beam-color2));
  }
  /* Active (hover/focus-driven) OR permanently featured -- either flag shows
     the beams. The SMIL <animate> elements run continuously regardless
     (native SVG animation, effectively free) -- opacity is what's gated. */
  .beam-card[data-beam-active='true'] .beam-track,
  .beam-card[data-beam-always-on='true'] .beam-track {
    opacity: 1;
  }
  .beam-content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .beam-card[data-beam-active='true'] .beam-track,
    .beam-card[data-beam-always-on='true'] .beam-track {
      opacity: 0.6;
      stroke-width: 1.5px;
    }
  }
</style>

<script>
  // SMIL <animate> has no CSS-media-query equivalent, so honor
  // prefers-reduced-motion by pausing every beam's animations in JS: a
  // static (offset-0) highlighted outline instead of a moving one.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.beam-svg').forEach((svg) => {
      if (svg instanceof SVGSVGElement) svg.pauseAnimations();
    });
  }
</script>
