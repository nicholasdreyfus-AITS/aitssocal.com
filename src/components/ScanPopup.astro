---
// AI Risk Scan promo: a floating "Free AI Risk Scan" button (always visible)
// plus a one-time-per-session popup that appears after 4s. Both link to the
// self-contained scan funnel served at /scan.html. Ported from the live site.
---

<!-- POPUP -->
<div class="scan-popup-overlay" id="scanPopup" role="dialog" aria-modal="true" aria-labelledby="scanPopupTitle">
  <div class="scan-popup">
    <button class="scan-popup-close" id="scanPopupClose" aria-label="Close">✕</button>
    <div class="scan-popup-eyebrow">FREE · 90 SECONDS · NO SIGNUP</div>
    <div class="scan-popup-title" id="scanPopupTitle">Is shadow AI already running in your business?</div>
    <div class="scan-popup-sub">
      Most SMBs have 3-7 unsanctioned AI tools active right now. Get your free AI Risk Score and see
      your top finding instantly.
    </div>
    <div class="scan-popup-perks">
      <div class="scan-popup-perk">AI Risk Score (0-100) for your organization</div>
      <div class="scan-popup-perk">Your #1 security finding, specific to your industry</div>
      <div class="scan-popup-perk">Shadow AI exposure estimate and compliance flags</div>
    </div>
    <div class="scan-popup-btns">
      <a href="/scan.html" class="scan-popup-cta">RUN MY FREE AI RISK SCAN →</a>
      <button class="scan-popup-skip" id="scanPopupSkip">I'll do it later</button>
    </div>
  </div>
</div>

<!-- FLOATING BUTTON -->
<a href="/scan.html" class="scan-fab" id="scanFab" aria-label="Free AI Risk Scan">
  <span class="scan-fab-dot"></span>
  Free AI Risk Scan
</a>

<script is:inline>
  (function () {
    var POPUP_KEY = 'aits_scan_popup_seen';
    var sp = document.getElementById('scanPopup');
    var sc = document.getElementById('scanPopupClose');
    var ss = document.getElementById('scanPopupSkip');
    var fab = document.getElementById('scanFab');
    if (!sp) return;
    var lastFocus = null;

    function focusables() {
      return sp.querySelectorAll('a[href], button:not([disabled])');
    }
    function trapTab(e) {
      if (e.key !== 'Tab') return;
      var f = focusables();
      if (!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
    function openPopup() {
      if (sp.classList.contains('open') || sessionStorage.getItem(POPUP_KEY)) return;
      lastFocus = document.activeElement;
      sp.classList.add('open');
      document.body.style.overflow = 'hidden';
      if (sc) sc.focus();
      sessionStorage.setItem(POPUP_KEY, '1');
    }
    function closePopup() {
      sp.classList.remove('open');
      document.body.style.overflow = '';
      sessionStorage.setItem(POPUP_KEY, '1');
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    if (sc) sc.addEventListener('click', closePopup);
    if (ss) ss.addEventListener('click', closePopup);
    sp.addEventListener('click', function (e) { if (e.target === this) closePopup(); });
    document.addEventListener('keydown', function (e) {
      if (!sp.classList.contains('open')) return;
      if (e.key === 'Escape') closePopup();
      else trapTab(e);
    });
    if (fab) {
      new MutationObserver(function () {
        fab.style.display = sp.classList.contains('open') ? 'none' : 'flex';
      }).observe(sp, { attributes: true, attributeFilter: ['class'] });
    }

    // Never auto-fire on the initial mobile viewport (intrusive-interstitial
    // risk + poor UX) — the always-visible FAB is the mobile entry point.
    // On desktop, invite on real engagement signals: exit-intent or 50% scroll.
    var isMobile = window.matchMedia('(max-width: 767px)').matches;
    if (!isMobile && !sessionStorage.getItem(POPUP_KEY)) {
      var onScroll = function () {
        var scrolled = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
        if (scrolled >= 0.5) { openPopup(); cleanup(); }
      };
      var onExit = function (e) { if (e.clientY <= 0) { openPopup(); cleanup(); } };
      function cleanup() {
        window.removeEventListener('scroll', onScroll);
        document.removeEventListener('mouseout', onExit);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('mouseout', onExit);
    }
  })();
</script>

<style>
  .scan-popup-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(7, 9, 15, 0.88);
    backdrop-filter: blur(8px);
    z-index: 200;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .scan-popup-overlay.open {
    display: flex;
  }
  .scan-popup {
    background: var(--bg2);
    border: 1px solid rgba(100, 120, 200, 0.25);
    border-radius: 16px;
    max-width: 460px;
    width: 100%;
    padding: 36px 32px;
    position: relative;
    animation: popupIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  @keyframes popupIn {
    from { opacity: 0; transform: scale(0.92) translateY(16px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  .scan-popup-close {
    position: absolute;
    top: 14px;
    right: 16px;
    background: transparent;
    border: none;
    color: var(--muted);
    font-size: 20px;
    cursor: pointer;
    line-height: 1;
    padding: 4px 6px;
  }
  .scan-popup-close:hover {
    color: var(--text);
  }
  .scan-popup-eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 10px;
    color: var(--teal);
    letter-spacing: 3px;
    margin-bottom: 10px;
  }
  .scan-popup-title {
    font-family: var(--fran);
    font-size: 23px;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 10px;
    color: var(--text);
  }
  .scan-popup-sub {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 22px;
  }
  .scan-popup-perks {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 26px;
  }
  .scan-popup-perk {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text2);
  }
  .scan-popup-perk::before {
    content: '✓';
    color: var(--teal);
    font-weight: 700;
    flex-shrink: 0;
  }
  .scan-popup-btns {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .scan-popup-cta {
    display: block;
    padding: 15px;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
  }
  .scan-popup-cta:hover {
    background: linear-gradient(135deg, #2d5cd8, #5a8df0);
    color: #fff;
    text-decoration: none;
  }
  .scan-popup-skip {
    background: transparent;
    border: none;
    color: var(--muted);
    font-size: 13px;
    cursor: pointer;
    text-align: center;
    padding: 6px;
    font-family: var(--jak);
  }
  .scan-popup-skip:hover {
    color: var(--text);
  }

  /* Floating button */
  .scan-fab {
    position: fixed;
    bottom: 28px;
    right: 24px;
    z-index: 150;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 13px 20px;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #fff;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 8px 32px rgba(59, 110, 240, 0.45);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .scan-fab:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(59, 110, 240, 0.6);
    color: #fff;
    text-decoration: none;
  }
  .scan-fab-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
    animation: fabPulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes fabPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }
  @media (max-width: 480px) {
    .scan-popup { padding: 28px 22px; }
    .scan-popup-title { font-size: 20px; }
    .scan-fab { bottom: 20px; right: 16px; font-size: 13px; padding: 11px 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scan-fab-dot { animation: none; }
  }
</style>
