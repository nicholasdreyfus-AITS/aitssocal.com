---
// AI Risk Scan promo: a floating "Free AI Risk Scan" pill (always visible,
// bottom-right) that expands in place into a bigger card after a short
// delay — once per session — instead of a full-screen modal. Both the pill
// and the expanded card's CTA link to the self-contained scan funnel at
// /scan.html.
---

<div class="scan-fab" id="scanFab">
  <button class="scan-fab-close" id="scanFabClose" aria-label="Dismiss">✕</button>
  <a href="/scan.html" class="scan-fab-main">
    <span class="scan-fab-dot"></span>
    <span class="scan-fab-label">Free AI Risk Scan</span>
  </a>
  <div class="scan-fab-body">
    <div class="scan-fab-eyebrow">FREE · 90 SECONDS · NO SIGNUP</div>
    <p class="scan-fab-copy">
      Most clients like to start here to learn their current AI readiness posture — and how a
      free 30-minute call, backed by a lot more data, helps you make faster decisions.
    </p>
    <a href="/scan.html" class="scan-fab-cta">Run my free AI Risk Scan →</a>
  </div>
</div>

<script is:inline>
  (function () {
    var SEEN_KEY = 'aits_scan_fab_seen';
    var DELAY_MS = 6000;
    var fab = document.getElementById('scanFab');
    var closeBtn = document.getElementById('scanFabClose');
    if (!fab) return;

    if (!sessionStorage.getItem(SEEN_KEY)) {
      setTimeout(function () {
        fab.classList.add('expanded');
      }, DELAY_MS);
    }

    function collapse() {
      fab.classList.remove('expanded');
      sessionStorage.setItem(SEEN_KEY, '1');
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        collapse();
      });
    }
  })();
</script>

<style>
  .scan-fab {
    position: fixed;
    bottom: 28px;
    right: 24px;
    z-index: 150;
    width: 208px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    border-radius: 50px;
    box-shadow: 0 8px 32px rgba(59, 110, 240, 0.45);
    overflow: hidden;
    transition:
      width 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-radius 0.45s ease,
      background 0.4s ease,
      box-shadow 0.4s ease;
  }
  .scan-fab.expanded {
    width: min(340px, calc(100vw - 48px));
    border-radius: 20px;
    background: var(--bg2);
    box-shadow: 0 20px 56px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(100, 120, 200, 0.25);
  }
  .scan-fab-close {
    position: absolute;
    top: 10px;
    right: 14px;
    background: transparent;
    border: none;
    color: var(--muted);
    font-size: 15px;
    cursor: pointer;
    line-height: 1;
    padding: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease 0.15s;
  }
  .scan-fab.expanded .scan-fab-close {
    opacity: 1;
    pointer-events: auto;
  }
  .scan-fab-main {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 13px 20px;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }
  .scan-fab-main:hover {
    color: #fff;
    text-decoration: none;
  }
  .scan-fab.expanded .scan-fab-main {
    border-bottom: 0.5px solid var(--border2);
  }
  .scan-fab-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
    animation: fabPulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes fabPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }
  .scan-fab-body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding-inline: 20px;
    transition:
      max-height 0.5s ease,
      opacity 0.35s ease,
      padding 0.4s ease;
  }
  .scan-fab.expanded .scan-fab-body {
    max-height: 320px;
    opacity: 1;
    padding: 16px 20px 22px;
  }
  .scan-fab-eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 10px;
    color: var(--teal);
    letter-spacing: 2.5px;
    margin-bottom: 10px;
  }
  .scan-fab-copy {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 16px;
  }
  .scan-fab-cta {
    display: block;
    text-align: center;
    padding: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 700;
  }
  .scan-fab-cta:hover {
    background: linear-gradient(135deg, #2d5cd8, #5a8df0);
    color: #fff;
    text-decoration: none;
  }
  @media (max-width: 480px) {
    .scan-fab {
      bottom: 20px;
      right: 16px;
      width: 172px;
    }
    .scan-fab-main {
      font-size: 13px;
      padding: 11px 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scan-fab-dot { animation: none; }
    .scan-fab, .scan-fab-body, .scan-fab-close { transition: none; }
  }
</style>
