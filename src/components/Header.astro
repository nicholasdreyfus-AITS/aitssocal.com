---
import { NAV } from '../consts';
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <nav class="container bar" aria-label="Primary">
    <a href="/" class="logo" aria-label="AITS home">
      <img class="logo-img" src="/images/logo.png" alt="AITS" width="46" height="46" />
      <span class="logo-text">
        <span class="logo-name">AITS</span>
        <span class="logo-full">Advanced Intelligent Technology Solutions</span>
      </span>
    </a>
    <ul class="nav-links">
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/contact" class="nav-cta">Free assessment</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(7, 9, 15, 0.82);
    backdrop-filter: blur(24px);
    border-bottom: 0.5px solid var(--border2);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo-img {
    height: 46px;
    width: auto;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
  }
  .logo-name {
    font-weight: 700;
    font-size: 16px;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .logo-full {
    font-size: 10px;
    color: var(--muted);
    line-height: 1.2;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin-inline-start: auto;
    margin-inline-end: 32px;
  }
  .nav-links a {
    font-size: 14px;
    color: var(--muted);
    font-weight: 500;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--text);
  }
  .nav-cta {
    background: var(--accent);
    color: #fff;
    padding: 9px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    box-shadow: 0 2px 16px rgba(59, 110, 240, 0.3);
    transition: background 0.2s, box-shadow 0.2s;
  }
  .nav-cta:hover {
    background: var(--accent2);
    color: #fff;
    box-shadow: 0 4px 24px rgba(59, 110, 240, 0.45);
    text-decoration: none;
  }
  @media (max-width: 820px) {
    .nav-links {
      display: none;
    }
    .logo-full {
      display: none;
    }
  }
</style>
