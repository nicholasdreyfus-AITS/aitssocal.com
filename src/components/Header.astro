---
import { NAV } from '../consts';
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <nav class="container bar" aria-label="Primary">
    <a href="/" class="logo" aria-label="AITS home">
      <img class="logo-img" src="/images/logo.png" alt="AITS" width="46" height="46" />
      <span class="logo-text">
        <span class="logo-name">AITS</span>
        <span class="logo-full">Advanced Intelligent Technology Solutions</span>
      </span>
    </a>
    <ul class="nav-links">
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/contact" class="nav-cta">Free assessment</a>
    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobileNav"
      aria-label="Open menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </nav>
  <div class="mobile-nav" id="mobileNav" hidden>
    <ul class="mobile-nav-links">
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/contact" class="nav-cta mobile-nav-cta">Free assessment</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const panel = document.getElementById('mobileNav');
  if (toggle && panel) {
    const close = () => {
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    };
    const open = () => {
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
    };
    toggle.addEventListener('click', () => (panel.hidden ? open() : close()));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > 820 && !panel.hidden) close();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(7, 9, 15, 0.82);
    backdrop-filter: blur(24px);
    border-bottom: 0.5px solid var(--border2);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo-img {
    height: 46px;
    width: auto;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
  }
  .logo-name {
    font-weight: 700;
    font-size: 16px;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .logo-full {
    font-size: 10px;
    color: var(--muted);
    line-height: 1.2;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin-inline-start: auto;
    margin-inline-end: 32px;
  }
  .nav-links a {
    font-size: 14px;
    color: var(--muted);
    font-weight: 500;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--text);
  }
  .nav-cta {
    background: var(--accent);
    color: #fff;
    padding: 9px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    box-shadow: 0 2px 16px rgba(59, 110, 240, 0.3);
    transition: background 0.2s, box-shadow 0.2s;
  }
  .nav-cta:hover {
    background: var(--accent2);
    color: #fff;
    box-shadow: 0 4px 24px rgba(59, 110, 240, 0.45);
    text-decoration: none;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 0.5px solid var(--border3);
    border-radius: 8px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .nav-toggle-bar {
    width: 18px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .mobile-nav {
    border-top: 0.5px solid var(--border2);
    background: rgba(7, 9, 15, 0.96);
    backdrop-filter: blur(24px);
    padding: 20px 5vw 26px;
  }
  .mobile-nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 18px;
  }
  .mobile-nav-links a {
    display: block;
    padding: 12px 4px;
    font-size: 16px;
    font-weight: 500;
    color: var(--text2);
    border-bottom: 0.5px solid var(--border);
  }
  .mobile-nav-links a:hover,
  .mobile-nav-links a[aria-current='page'] {
    color: var(--text);
  }
  .mobile-nav-cta {
    display: block;
    text-align: center;
    padding: 13px;
  }
  @media (max-width: 820px) {
    .nav-links {
      display: none;
    }
    .logo-full {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
  @media (min-width: 821px) {
    .mobile-nav {
      display: none;
    }
  }
</style>
